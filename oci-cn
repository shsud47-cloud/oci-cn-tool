# 列出指定 zoneinfo 目录下的全部时区供选择
_tz_pick(){
  local -a zones=() d z
  for d in "$@"; do
    if [ "$d" = "ROOTFILES" ]; then
      while IFS= read -r z; do zones+=("$z"); done < <(cd /usr/share/zoneinfo 2>/dev/null && find . -maxdepth 1 -type f ! -name '*.tab' ! -name '*.list' ! -name 'leapseconds' ! -name 'localtime' ! -name 'posixrules' | sed 's|^\./||' | sort)
    else
      while IFS= read -r z; do zones+=("$d/$z"); done < <(cd "/usr/share/zoneinfo/$d" 2>/dev/null && find . -type f | sed 's|^\./||' | sort)
    fi
  done
  local n=${#zones[@]} i=0 c sel
  [ "$n" -eq 0 ] && { echo "$(_t "无可用时区" "L_TZ_NONE")"; return; }
  for z in "${zones[@]}"; do
    i=$((i+1)); printf " %3d %-30s" "$i" "$z"
    [ $((i % 2)) -eq 0 ] && echo
  done
  [ $((i % 2)) -ne 0 ] && echo
  _ask -rp "$(_t "选择" "L_CHOOSE") (1-$n, 0 $(_t "返回" "L_BACK")): " c
  case "$c" in 0|"") return;; esac
  if [ "$c" -ge 1 ] 2>/dev/null && [ "$c" -le "$n" ] 2>/dev/null; then
    sel="${zones[$((c-1))]}"
    if [ -f "/usr/share/zoneinfo/$sel" ]; then
      echo "$sel" > "$HOME_DIR/timezone"
      echo "$(_t "已设为 %s" "L_TZ_SET" "$sel")"
    else
      echo "$(_t "无效的时区" "L_TZ_INVALID")"
    fi
  else
    echo "$(_t "无效的选择" "L_TZ_INVALID_SEL")"
  fi
}
