# 串行控制台救砖：SSH 连不上时，通过控制台进系统改公钥
inst_console(){
  pick_instance || return
  echo "串行控制台救砖（用于 SSH 连不上时进系统）"
  echo "先贴一个临时公钥（用于认证控制台连接本身，建议用面板机的 ~/.ssh/id_ed25519.pub）："
  echo "粘贴公钥（ssh-ed25519... 或 ssh-rsa...）："
  _ask -r pubkey
  [[ "$pubkey" == ssh-* ]] || { echo "$(_t "不是有效公钥" "L_INVALID_PUBKEY")"; return; }
  local kf="$RUN_DIR/console.pub"; echo "$pubkey" > "$kf"
  # 先看有没有已存在的控制台连接，有则复用
  local cid
  cid=$(o compute instance-console-connection list -c "$TENANCY" --instance-id "$SEL_ID" \
    --query 'data[?"lifecycle-state"==`"ACTIVE"`].id|[0]' --raw-output 2>/dev/null)
  if [ -z "$cid" ] || [ "$cid" = null ]; then
    echo "创建控制台连接中..."
    cid=$(o compute instance-console-connection create --instance-id "$SEL_ID" --ssh-public-key-file "$kf" \
      --query 'data.id' --raw-output 2>&1 | tail -1)
    [[ "$cid" == ocid1.instanceconsoleconnection* ]] || { echo "创建失败："; echo "$cid"|tail -3; return; }
    echo "等待连接就绪..."; sleep 6
  else
    echo "已有活动的控制台连接，直接复用。"
  fi
  local conn
  conn=$(o compute instance-console-connection get --instance-console-connection-id "$cid" \
    --query 'data."connection-string"' --raw-output 2>/dev/null)
  echo; line
  echo "串行控制台连接命令（在面板机执行，用刚才那个公钥对应的私钥）："
  echo
  echo "$conn"
  echo
  line
  cat <<'EOF'
进入控制台后改实例公钥的步骤：
1. 执行上面的连接命令，回车后会黑屏，再敲一次回车出现登录/引导。
2. 重启实例（在另一个终端用本工具 重启），控制台会显示开机过程。
3. 开机时在 GRUB 菜单按 e，编辑内核行，末尾加  init=/bin/bash  按 Ctrl+X 进入。
4. 进单用户后执行：
     mount -o remount,rw /
     # Ubuntu 默认用户 ubuntu，Oracle Linux 用 opc
     su - ubuntu   （或直接编辑对应家目录）
     echo "你的新公钥" >> /home/ubuntu/.ssh/authorized_keys
     chmod 600 /home/ubuntu/.ssh/authorized_keys
     chown ubuntu:ubuntu /home/ubuntu/.ssh/authorized_keys
     sync; exec /sbin/init
5. 系统正常启动后，用新私钥 SSH 即可登录。
提示：不同镜像默认用户名不同（Ubuntu=ubuntu，OL=opc，Debian=debian）。
EOF
  line
  _ask -rp "用完是否删除此控制台连接？(y/n): " d
  [ "$d" = y ] && { o compute instance-console-connection delete --instance-console-connection-id "$cid" --force >/dev/null 2>&1 && echo "已删除控制台连接。"; }
  notify "串行控制台" "$SEL_NAME" "已创建控制台连接用于救砖" "状态：$(o compute instance-console-connection get --instance-console-connection-id "$cid" --query 'data."lifecycle-state"' --raw-output 2>/dev/null)"
  pause
}
# ============ 自定义镜像：从实例创建 / 删除 ============
inst_create_image(){
  pick_instance || return
  local st; st=$(_inst_state "$SEL_ID")
  echo "$(_t "实例：${SEL_NAME}（${st}）" "L_IMG_INST" "$SEL_NAME" "$st")"
  if [ "$st" != "STOPPED" ]; then
    echo "$(_t "为保证镜像数据一致，建议先关机再创建。运行中创建也可以，但有极小概率文件不一致。" "L_IMG_WARN_RUNNING")"
    local sh; _ask -rp "$(_t "是否先关机？(y=关机后创建/n=直接创建) [n]: " "L_IMG_ASK_STOP")" sh; sh="${sh:-n}"
    if [ "$sh" = "y" ] || [ "$sh" = "Y" ]; then
      echo "$(_t "关机中..." "L_STOPPING")"
      o compute instance action --instance-id "$SEL_ID" --action SOFTSTOP >/dev/null 2>&1
      local t=0 s=""
      while [ "$t" -lt 300 ]; do
        s=$(_inst_state "$SEL_ID"); [ "$s" = "STOPPED" ] && break
        printf "."; sleep 10; t=$((t+10))
      done
      echo
      [ "$s" != "STOPPED" ] && { echo "$(_t "关机超时，取消创建。" "L_IMG_STOP_TIMEOUT")"; return; }
    fi
  fi
  local d; d=$(date +%Y%m%d)
  local iname; _ask -rp "$(_t "镜像名" "L_IMG_NAME") [${SEL_NAME}-image-${d}]: " iname; iname="${iname:-${SEL_NAME}-image-${d}}"
  _confirm "$(_t "确认为实例 ${SEL_NAME} 创建自定义镜像 ${iname}？" "L_IMG_CONFIRM" "$SEL_NAME" "$iname")" || return
  echo "$(_t "创建中..." "L_CREATING")"
  local imgid; imgid=$(o compute image create -c "$TENANCY" --instance-id "$SEL_ID" --display-name "$iname" --query "data.id" --raw-output 2>&1)
  if [[ "$imgid" != ocid1.image* ]]; then echo "$(_t "失败：" "L_FAILED")$(_oci_err "$imgid")"; return; fi
  echo "$(_t "已提交，等待镜像可用（最多10分钟）..." "L_IMG_WAIT")"
  local t=0 ist=""
  while [ "$t" -lt 600 ]; do
    ist=$(o compute image get --image-id "$imgid" --query "data.\"lifecycle-state\"" --raw-output 2>/dev/null)
    [ "$ist" = "AVAILABLE" ] && break
    [ "$ist" = "FAILED" ] && break
    printf "."; sleep 10; t=$((t+10))
  done
  echo
  if [ "$ist" = "AVAILABLE" ]; then
    echo "$(_t "镜像创建完成：${iname}" "L_IMG_DONE" "$iname")"
  else
    echo "$(_t "镜像状态：${ist}（可在控制台查看详情）" "L_IMG_STATE" "$ist")"
  fi
}
