# 时间格式化：转用户配置时区（默认北京时间），可选附带已过天数
_fmt_time(){ [ -z "$1" ] || [ "$1" = null ] && { echo "-"; return; }; local d; d=$(TZ=$(get_tz) date -d "$1" '+%Y-%m-%d %H:%M' 2>/dev/null) || { echo "$1"; return; }
  if [ "$2" = days ]; then local n=$(( ( $(date +%s) - $(date -d "$1" +%s) ) / 86400 )); echo "$d（已 ${n} 天）"; else echo "$d"; fi; }
tenant_detail(){
  echo "$(_t "读取租户信息..." "L_READING_TENANT")"
  local hr="${HOME_REGION:-$OCI_REGION}" cfg; cfg=$(oci_cfg "$ACC_NAME" "$hr")
  local info; info=$(oci --config-file "$cfg" --region "$hr" iam tenancy get --tenancy-id "$TENANCY" 2>/dev/null)
  [ -z "$info" ] && { echo "$(_t "读取失败" "L_READ_FAIL")"; return; }
  local tname desc
  tname=$(echo "$info" | jq -r '.data.name // "-"')
  desc=$(echo "$info" | jq -r '.data.description // "-"')
  # 建立时间：租户即根区间，查根区间的 time-created
  local tcreated; tcreated=$(oci --config-file "$cfg" --region "$hr" iam compartment get --compartment-id "$TENANCY" \
    --query 'data."time-created"' --raw-output 2>/dev/null)
  # 套餐与升级时间：实时查订阅（主区域端点）
  local sub plan tup
  sub=$(oci --config-file "$cfg" --region "$hr" osp-gateway subscription-service subscription list --compartment-id "$TENANCY" \
    --osp-home-region "$hr" 2>/dev/null)
  plan=$(echo "$sub" | jq -r '(.data.items[0] // .data[0])."plan-type" // empty' 2>/dev/null)
  tup=$(echo "$sub" | jq -r '(.data.items[0] // .data[0])."time-plan-upgrade" // empty' 2>/dev/null)
  # 已订阅区域：主区域排前
  local regs; regs=$(oci --config-file "$cfg" --region "$hr" iam region-subscription list --tenancy-id "$TENANCY" 2>/dev/null \
    | jq -r '.data | sort_by(."is-home-region"|not) | .[]."region-name"' 2>/dev/null)
  local rcnt=0 rlist="" r
  while read -r r; do [ -z "$r" ] && continue; rcnt=$((rcnt+1)); rlist="${rlist}${rlist:+、}$r $(region_cn "$r")"; done <<< "$regs"
  echo "  租户名称：$tname"
  echo "  描述：$desc"
  echo "  套餐：${plan:-查询失败}"
  echo "  建立时间：$(_fmt_time "$tcreated" days)"
  [ "$plan" = PAYG ] && [ -n "$tup" ] && echo "  升级PAYG：$(_fmt_time "$tup")"
  echo "  主区域：$hr $(region_cn "$hr")"
  echo "  已订阅区域（$rcnt/3）：${rlist:--}"
  echo "  租户OCID：$TENANCY"
  echo
  echo " 1 订阅新区域（开通副区域）   0 返回"
  _ask -rp "$(_t "选择: " "L_ASK_CHOOSE")" d
