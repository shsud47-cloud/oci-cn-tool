# ============ 密码（输错达上限删除所有加密密钥和账号配置） ============
unlock(){
  [ -f "$HOME_DIR/.nopass" ] && { PASS=""; return 0; }
  if [ ! -f "$VERIFY_ENC" ]; then
    echo "$(_t "首次使用，设置解密密码（加密所有 API 私钥）" "L_SET_PASSWD")"
    local p1 p2
    _ask -rsp "设置密码: " p1; echo
    _ask -rsp "再输一次: " p2; echo
    [ "$p1" != "$p2" ] && { echo "$(_t "两次不一致" "L_PASSWD_MISMATCH")"; exit 1; }
    [ -z "$p1" ] && { echo "$(_t "密码不能为空" "L_PASSWD_EMPTY")"; exit 1; }
    PASS="$p1"
    printf '%s' "$VERIFY_TOKEN" | OCN_PW="$PASS" openssl enc -aes-256-cbc -pbkdf2 -salt -pass env:OCN_PW -out "$VERIFY_ENC" 2>/dev/null
    echo "0" > "$ATTEMPT_FILE"; echo "$(_t "密码已设置。" "L_PASSWD_SET")"; return 0
  fi
  local att; att=$(cat "$ATTEMPT_FILE" 2>/dev/null || echo 0)
  # PASS 预设（--password / OCI_CN_PASS）视为非交互，只试一次；交互式输错可无限重试，永不删除文件
  local preset=0; [ -n "$PASS" ] && preset=1
  while true; do
    if [ -z "$PASS" ]; then
      [ -t 0 ] || { echo "$(_t "密码错误" "L_PASSWD_WRONG_ONCE")"; exit 1; }
      _ask -rsp "$(_t "解密密码: " "L_ASK_PASSWD")" PASS || { echo; exit 1; }
      echo
    fi
    local got; got=$(OCN_PW="$PASS" openssl enc -d -aes-256-cbc -pbkdf2 -pass env:OCN_PW -in "$VERIFY_ENC" 2>/dev/null)
    if [ "$got" = "$VERIFY_TOKEN" ]; then echo "0" > "$ATTEMPT_FILE"; return 0; fi
    att=$((att+1)); echo "$att" > "$ATTEMPT_FILE"
    [ "$preset" = "1" ] && { echo "$(_t "密码错误" "L_PASSWD_WRONG_ONCE")"; exit 1; }
    echo "$(_t "密码错误，请重试。" "L_PASSWD_RETRY")"
    PASS=""
  done
}
enc_key(){ OCN_PW="$PASS" openssl enc -aes-256-cbc -pbkdf2 -salt -pass env:OCN_PW -in "$1" -out "$2" 2>/dev/null; }
dec_key(){ OCN_PW="$PASS" openssl enc -d -aes-256-cbc -pbkdf2 -pass env:OCN_PW -in "$1" -out "$2" 2>/dev/null; }

# ============ 解密到 /dev/shm ============
prepare_runtime(){
  [ -n "$RUN_DIR" ] && [ -d "$RUN_DIR" ] && return 0
  RUN_DIR=$(mktemp -d /dev/shm/oci-cn.XXXXXX) || { echo "/dev/shm 不可用"; exit 1; }
  chmod 700 "$RUN_DIR"
  [ -f "$ACC_FILE" ] || return 0
  while IFS=$'\t' read -r name _t _u _f _h _tn _pl _st; do
    [ -z "$name" ] && continue
    if [ -f "$HOME_DIR/.nopass" ] && [ -f "$KEYS_DIR/$name.pem" ]; then
      cp "$KEYS_DIR/$name.pem" "$RUN_DIR/$name.pem"; chmod 600 "$RUN_DIR/$name.pem";
    elif [ -f "$KEYS_DIR/$name.pem.enc" ]; then
      dec_key "$KEYS_DIR/$name.pem.enc" "$RUN_DIR/$name.pem"; chmod 600 "$RUN_DIR/$name.pem";
    fi
  done < "$ACC_FILE"
}

oci_cfg(){  # $1=name $2=region -> 回显配置文件路径
  local name="$1" region="$2" cfg="$RUN_DIR/$1.config"
  local tenancy user fp
  IFS=$'\t' read -r _n tenancy user fp _rest < <(awk -F'\t' -v n="$name" '$1==n' "$ACC_FILE")
  cat > "$cfg" <<EOF
[DEFAULT]
user=$user
fingerprint=$fp
tenancy=$tenancy
region=$region
key_file=$RUN_DIR/$name.pem
EOF
  chmod 600 "$cfg"; echo "$cfg"
}
o(){ oci --config-file "$OCI_CFG" --region "$OCI_REGION" "$@"; }

# ============ 账号读取 ============
list_accounts(){
  [ -s "$ACC_FILE" ] || { echo "（无账号，先到系统配置添加或导入）"; return 1; }
  echo "编号  账号名          套餐     状态     租户"
  local i=0
  while IFS=$'\t' read -r name t u f home tname plan status; do
    [ -z "$name" ] && continue; i=$((i+1))
    printf "%-4s  %-14s %-8s %-8s %s\n" "$i" "$name" "${plan:-—}" "${status:-—}" "${tname:-—}"
  done < "$ACC_FILE"
}
get_account_by_index(){ awk -v n="$1" 'NF{c++; if(c==n){print; exit}}' "$ACC_FILE"; }

# ============ 导入 oci-helper ============
import_from_helper(){
  local db="$1"; local keydir; keydir=$(dirname "$db")/keys
  command -v sqlite3 >/dev/null || { echo "缺少 sqlite3：apt install -y sqlite3"; return 1; }
  [ -f "$db" ] || { echo "找不到 $db"; return 1; }
  echo "读取账号（按租户合并，区域忽略）..."
  local rows; rows=$(sqlite3 -separator $'\t' "$db" \
    "select username, oci_tenant_id, oci_user_id, oci_fingerprint, oci_key_path, coalesce(tenant_name,''), coalesce(plan_type,''), coalesce(account_status,'') from oci_user group by oci_tenant_id;")
  [ -z "$rows" ] && { echo "$(_t "无数据" "L_NO_DATA")"; return 1; }
  local n=0
  while IFS=$'\t' read -r username tenancy user fp keypath tname plan status; do
    [ -z "$username" ] && continue
    local src="$keypath"; [ -f "$src" ] || src="$keydir/$(basename "$keypath")"
    [ -f "$src" ] || { echo "  跳过 $username：找不到密钥"; continue; }
    local aname="$username" k=1
    while awk -F'\t' -v n="$aname" '$1==n{found=1; exit} END{exit !found}' "$ACC_FILE" 2>/dev/null; do aname="${username}_$k"; k=$((k+1)); done
    enc_key "$src" "$KEYS_DIR/$aname.pem.enc"
    dec_key "$KEYS_DIR/$aname.pem.enc" "$RUN_DIR/$aname.pem" 2>/dev/null; chmod 600 "$RUN_DIR/$aname.pem" 2>/dev/null
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$aname" "$tenancy" "$user" "$fp" "-" "${tname:--}" "${plan:--}" "${status:--}" >> "$ACC_FILE"
    n=$((n+1)); echo "$(_t "  导入 %s" "L_IMPORT_X" "$aname")"
  done <<< "$rows"
  echo "$(_t "共导入 %s 个。逐个验证..." "L_IMPORTED_N" "$n")"; verify_all
  echo; echo "$(_t "全部 ✓ 后再删除 oci-helper：" "L_DEL_HELPER_HINT")"
  echo "  docker rm -f oci-helper oci-helper-watcher websockify 2>/dev/null; rm -rf /app/oci-helper"
}

verify_all(){
  local ok=0 bad=0
  export OCI_CLI_SUPPRESS_FILE_PERMISSIONS_WARNING=True
  while IFS=$'\t' read -r name tenancy user fp home tname plan status; do
    [ -z "$name" ] && continue
    [ "$home" = - ] && home=""
    # 模式：missing=只处理信息不完整的；only:名字=只验证该账号；空=全部
    case "$1" in
      missing) if [ -n "$home" ] && [ -n "$tname" ] && [ "$tname" != - ] && [[ "$plan" =~ ^(FREE_TIER|PAYG)$ ]] && [ "$status" = ACTIVE ]; then
                 echo "$(_t "  · %s 信息完整，跳过" "L_SKIP_COMPLETE" "$name")"; ok=$((ok+1)); continue; fi;;
      only:*) [ "$name" = "${1#only:}" ] || continue;;
    esac
    local hr="" guess; guess=$(name_to_region "$name")
    # 第一步：优先用保存的主区域（添加时从配置解析的 region）
    if [ -n "$home" ]; then
      OCI_CFG=$(oci_cfg "$name" "$home")
      hr=$(oci --config-file "$OCI_CFG" --region "$home" iam region-subscription list --tenancy-id "$tenancy" \
           --query 'data[?"is-home-region"]."region-name"|[0]' --raw-output 2>/dev/null)
      [ "$hr" = null ] && hr=""
    fi
    # 第二步：名字猜的区域
    if [ -z "$hr" ] && [ -n "$guess" ]; then
      OCI_CFG=$(oci_cfg "$name" "$guess")
      hr=$(oci --config-file "$OCI_CFG" --region "$guess" iam region-subscription list --tenancy-id "$tenancy" \
           --query 'data[?"is-home-region"]."region-name"|[0]' --raw-output 2>/dev/null)
      [ "$hr" = null ] && hr=""
    fi
    # 第三步：轮询兜底（全区域）
    if [ -z "$hr" ]; then
      for r in ap-tokyo-1 ap-osaka-1 ap-seoul-1 ap-chuncheon-1 ap-singapore-1 ap-singapore-2 \
               ap-mumbai-1 ap-hyderabad-1 ap-sydney-1 ap-melbourne-1 ap-hongkong-1 ap-kulai-2 ap-batam-1 \
               us-ashburn-1 us-phoenix-1 us-sanjose-1 us-chicago-1 ca-toronto-1 ca-montreal-1 \
               uk-london-1 uk-cardiff-1 eu-frankfurt-1 eu-amsterdam-1 eu-zurich-1 eu-milan-1 \
               eu-paris-1 eu-marseille-1 eu-stockholm-1 eu-madrid-1 eu-madrid-3 eu-turin-1 \
               me-dubai-1 me-abudhabi-1 me-jeddah-1 me-riyadh-1 \
               sa-saopaulo-1 sa-santiago-1 sa-vinhedo-1 sa-valparaiso-1 sa-bogota-1 \
               af-johannesburg-1 af-casablanca-1 il-jerusalem-1 mx-monterrey-1 mx-queretaro-1; do
        [ "$INTR" = 1 ] && { INTR=0; break; }
        [ -z "$r" ] || [ "$r" = "$guess" ] || [ "$r" = "$home" ] && continue
        OCI_CFG=$(oci_cfg "$name" "$r")
        hr=$(oci --config-file "$OCI_CFG" --region "$r" iam region-subscription list --tenancy-id "$tenancy" \
             --query 'data[?"is-home-region"]."region-name"|[0]' --raw-output 2>/dev/null)
        [ -n "$hr" ] && [ "$hr" != null ] && break
        hr=""
      done
    fi
    if [ -n "$hr" ]; then
      ok=$((ok+1)); echo "  ✓ $name（主区域 $hr $(region_cn "$hr")）"
      awk -F'\t' -v OFS='\t' -v n="$name" -v h="$hr" '$1==n{$5=h}1' "$ACC_FILE" > "$ACC_FILE.tmp" && mv "$ACC_FILE.tmp" "$ACC_FILE"
      # 租户名/套餐/状态：不完整时在主区域查询补全（空值存为 - ，避免 tab 分隔错位）
      if [ -z "$tname" ] || [ "$tname" = - ] || ! [[ "$plan" =~ ^(FREE_TIER|PAYG)$ ]] || [ "$status" != ACTIVE ]; then
        OCI_CFG=$(oci_cfg "$name" "$hr")
        local tn pl perr
        tn=$(oci --config-file "$OCI_CFG" --region "$hr" iam tenancy get --tenancy-id "$tenancy" --query 'data.name' --raw-output 2>/dev/null)
        [ -z "$tn" ] || [ "$tn" = null ] && tn="${tname:--}"
        [[ "$plan" =~ ^(FREE_TIER|PAYG)$ ]] && pl="$plan" || {
          perr=$(oci --config-file "$OCI_CFG" --region "$hr" osp-gateway subscription-service subscription list --compartment-id "$tenancy" --osp-home-region "$hr" \
                 --query 'data.items[0]."plan-type" || data[0]."plan-type"' --raw-output 2>&1)
          pl=$(echo "$perr" | grep -m1 -xE 'FREE_TIER|PAYG'); [ -z "$pl" ] && pl="-"
        }
        awk -F'\t' -v OFS='\t' -v n="$name" -v a="$tn" -v b="$pl" '$1==n{$6=a;$7=b;$8="ACTIVE"}1' "$ACC_FILE" > "$ACC_FILE.tmp" && mv "$ACC_FILE.tmp" "$ACC_FILE"
        if [ "$pl" = - ]; then echo "      租户：$tn  套餐：未知（查询失败：$(_oci_err "$perr")）"
        else echo "      租户：$tn  套餐：$pl"; fi
      fi
    else
      bad=$((bad+1)); echo "$(_t "  ✗ %s 调用失败（密钥或权限问题）" "L_CALL_FAIL" "$name")"
    fi
  done < "$ACC_FILE"
  echo "$(_t "可用 %s 个，失败 %s 个。" "L_AVAIL_X" "$ok" "$bad")"
}

# 租户可用性验证：每个账号实测一次 API；通→ACTIVE，不通→INVALID。$1=quiet 时只输出汇总
verify_usability(){
  local quiet=0; [ "$1" = quiet ] && quiet=1
  local ok=0 bad=0 bad_names=""
  export OCI_CLI_SUPPRESS_FILE_PERMISSIONS_WARNING=True
  while IFS=$'\t' read -r name tenancy user fp home tname plan status; do
    [ -z "$name" ] && continue
    local r="$home"; [ "$r" = - ] && r=""; [ -z "$r" ] && r=$(name_to_region "$name")
    local good=0 try
    for try in "$r" "$(name_to_region "$name")"; do
      [ -z "$try" ] && continue
      local cfg; cfg=$(oci_cfg "$name" "$try")
      local out
      out=$(timeout 30 oci --config-file "$cfg" --region "$try" iam region-subscription list --tenancy-id "$tenancy" \
        --query 'data[?"is-home-region"]."region-name"|[0]' --raw-output 2>/dev/null)
      if [ $? -eq 0 ] && [ -n "$out" ] && [ "$out" != null ]; then good=1; break; fi
    done
    if [ "$good" = 1 ]; then
      ok=$((ok+1)); [ "$quiet" = 0 ] && echo "  ✓ $name 可用"
      awk -F'\t' -v OFS='\t' -v n="$name" '$1==n{$8="ACTIVE"}1' "$ACC_FILE" > "$ACC_FILE.tmp" && mv "$ACC_FILE.tmp" "$ACC_FILE"
    else
      bad=$((bad+1)); [ "$quiet" = 0 ] && echo "  ✗ $name 不可用，已标 INVALID"
      bad_names="${bad_names}${name} "
    fi
  done < "$ACC_FILE"
  if [ "$quiet" = 1 ] && [ "$ok" = 0 ] && [ "$bad" -gt 0 ]; then
    echo "$(_t "租户验证：全部失败，疑似网络问题，未修改状态。" "L_TENANT_NET")"
  else
    local n
    for n in $bad_names; do
      awk -F'\t' -v OFS='\t' -v n="$n" '$1==n{$8="INVALID"}1' "$ACC_FILE" > "$ACC_FILE.tmp" && mv "$ACC_FILE.tmp" "$ACC_FILE"
    done
    echo "$(_t "租户验证：可用 %s 个，失效 %s 个。" "L_TENANT_CHECK" "$ok" "$bad")"
  fi
}

add_account(){
  local name tenancy user fp keyfile
  echo "$(_t "添加账号，方式：" "L_ADD_ACCT_WAY")"
  echo "$(_t " 1 粘贴配置+粘贴私钥（推荐）" "L_ADD_WAY1")"
  echo "$(_t " 2 逐项输入+私钥文件路径" "L_ADD_WAY2")"
  _ask -rp "$(_t "选择: " "L_ASK_CHOOSE")" way
  _ask -rp "账号名（建议带地名，如 美国阿什本）: " name; [ -z "$name" ] && return
  [[ "$name" == *"/"* ]] && { echo "$(_t "账号名不能含 /" "L_NAME_NO_SLASH")"; return; }
  awk -F'\t' -v n="$name" '$1==n{found=1; exit} END{exit !found}' "$ACC_FILE" 2>/dev/null && { echo "$(_t "已存在同名账号" "L_DUP_ACCT")"; return; }

  if [ "$way" = 1 ]; then
    echo "$(_t "粘贴控制台的 [DEFAULT] 配置段，粘完另起一行输入 END 回车：" "L_PASTE_CONFIG")"
    local cfgtext="" ln
    while IFS= read -r ln; do [ "$ln" = "END" ] && break; cfgtext+="$ln"$'\n'; done
    [ "$INTR" = 1 ] && { INTR=0; echo "已取消"; return; }
    tenancy=$(echo "$cfgtext" | grep -iE '^tenancy' | head -1 | cut -d= -f2- | tr -d ' \r')
    user=$(echo "$cfgtext" | grep -iE '^user' | head -1 | cut -d= -f2- | tr -d ' \r')
    fp=$(echo "$cfgtext" | grep -iE '^fingerprint' | head -1 | cut -d= -f2- | tr -d ' \r')
    local cfgregion; cfgregion=$(echo "$cfgtext" | grep -iE '^region' | head -1 | cut -d= -f2- | tr -d ' \r')
    [ -z "$tenancy" ] || [ -z "$user" ] || [ -z "$fp" ] && { echo "$(_t "配置解析失败，缺 tenancy/user/fingerprint" "L_CONFIG_PARSE_FAIL")"; return; }
    echo "已解析：tenancy=${tenancy: -8}  user=${user: -8}  fp=$fp"
    echo "$(_t "粘贴私钥（含 BEGIN/END 两行整段），粘完另起一行输入 END 回车：" "L_PASTE_KEY")"
    local keytext="" kl
    while IFS= read -r kl; do [ "$kl" = "END" ] && break; keytext+="$kl"$'\n'; done
    [ "$INTR" = 1 ] && { INTR=0; echo "已取消"; return; }
    echo "$keytext" | grep -q "BEGIN" || { echo "$(_t "不是有效私钥（缺 BEGIN 行）" "L_INVALID_KEY")"; return; }
    # 明文私钥直接加密，不落地
    printf '%s' "$keytext" | OCN_PW="$PASS" openssl enc -aes-256-cbc -pbkdf2 -salt -pass env:OCN_PW -out "$KEYS_DIR/$name.pem.enc" 2>/dev/null
  else
    _askc "$(_t "租户 OCID" "L_TENANCY_OCID")" tenancy || return
    _askc "$(_t "用户 OCID" "L_USER_OCID")" user || return
    _askc "$(_t "指纹" "L_FINGERPRINT")" fp || return
    _askc "$(_t "主区域（如 ap-kulai-2，可留空）" "L_MAIN_REGION")" cfgregion || return
    _askc "$(_t "私钥 pem 路径" "L_KEY_PATH")" keyfile || return
    [ -f "$keyfile" ] || { echo "$(_t "密钥文件不存在" "L_KEY_NOT_FOUND")"; return; }
    enc_key "$keyfile" "$KEYS_DIR/$name.pem.enc"
  fi

  dec_key "$KEYS_DIR/$name.pem.enc" "$RUN_DIR/$name.pem" 2>/dev/null; chmod 600 "$RUN_DIR/$name.pem" 2>/dev/null
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$tenancy" "$user" "$fp" "${cfgregion:--}" "-" "-" "-" >> "$ACC_FILE"
  echo "$(_t "验证中..." "L_VERIFYING")"; verify_all "only:$name"
}
del_account(){
  list_accounts || return
  _askc "$(_t "删除编号" "L_DEL_NUM")" idx || return
  local row; row=$(get_account_by_index "$idx"); [ -z "$row" ] && { echo "无效"; return; }
  local name; name=$(echo "$row" | cut -f1)
  _ask -rp "$(_t "确认删除 %s 及密钥？(yes/n): " "L_ASK_DEL_ACCT" "$name")" c; [ "$c" != yes ] && return
  awk -F'\t' -v n="$name" '$1!=n' "$ACC_FILE" > "$ACC_FILE.tmp" && mv "$ACC_FILE.tmp" "$ACC_FILE"
  rm -f "$KEYS_DIR/$name.pem.enc" "$RUN_DIR/$name.pem"; echo "$(_t "已删除。" "L_DELETED")"
}

# ============ 区域选择 ============
choose_region(){  # $1=name $2=tenancy $3=home
  local name="$1" tenancy="$2" home="$3"
  export OCI_CLI_SUPPRESS_FILE_PERMISSIONS_WARNING=True
  local regions="" guess; guess=$(name_to_region "$name")
  for r in "$guess" "$home" ap-osaka-1 ap-tokyo-1 ap-seoul-1 ap-chuncheon-1 ap-singapore-1 ap-singapore-2 \
           us-ashburn-1 us-phoenix-1 us-sanjose-1 uk-london-1 eu-frankfurt-1 \
           eu-paris-1 eu-amsterdam-1 ap-mumbai-1 ap-hyderabad-1 ca-toronto-1 sa-saopaulo-1; do
    [ "$INTR" = 1 ] && { INTR=0; break; }
    [ -z "$r" ] && continue
    local tmpcfg; tmpcfg=$(oci_cfg "$name" "$r")
    regions=$(oci --config-file "$tmpcfg" --region "$r" iam region-subscription list --tenancy-id "$tenancy" \
      --query 'data[].["region-name","is-home-region"]' 2>/dev/null | jq -r '.[]|@tsv')
    [ -n "$regions" ] && break
  done
  [ -z "$regions" ] && { echo "读取区域失败（所有区域认证均未通过，检查密钥或网络）"; return 1; }
  echo "$(_t "已订阅区域（扫描实例中…）：" "L_SUB_REGIONS")"; REG_ARR=(); local i=0
  while IFS=$'\t' read -r rn ishome; do
    [ "$INTR" = 1 ] && { INTR=0; break; }
    [ -z "$rn" ] && continue; i=$((i+1)); REG_ARR[$i]="$rn"
    local mark=""; [ "$ishome" = "true" ] && mark="（主区域）"
    # 统计该区域运行中的实例数
    local cfg cnt
    cfg=$(oci_cfg "$name" "$rn")
    cnt=$(oci --config-file "$cfg" --region "$rn" compute instance list -c "$tenancy" --all \
          --query 'length(data[?"lifecycle-state"==`"RUNNING"`])' --raw-output 2>/dev/null)
    local busy=""; [ -n "$cnt" ] && [ "$cnt" -gt 0 ] 2>/dev/null && busy="  ● 有${cnt}台"
    printf "  %s  %-18s %s%s%s\n" "$i" "$rn" "$(region_cn "$rn")" "$mark" "$busy"
  done <<< "$regions"
  _ask -rp "$(_t "选择区域编号: " "L_ASK_REGION_NUM")" ridx
  OCI_REGION="${REG_ARR[$ridx]}"; [ -z "$OCI_REGION" ] && { echo "无效"; return 1; }
  return 0
}

# ============ 实例 ============
# 列出实例已挂载（ATTACHED）的块存储卷。$1=实例ID $2=可用域。输出：名称<TAB>大小G<TAB>卷ID
_inst_data_vols(){
  local vid
  for vid in $(o compute volume-attachment list -c "$TENANCY" --availability-domain "$2" --instance-id "$1" --all 2>/dev/null \
      | jq -r '.data[]? | select(."lifecycle-state"=="ATTACHED") | ."volume-id"' 2>/dev/null); do
    o bv volume get --volume-id "$vid" 2>/dev/null | jq -r --arg v "$vid" '.data | [."display-name", (."size-in-gbs"|tostring), $v] | @tsv' 2>/dev/null
  done
}
inst_list(){
  echo "$(_t "读取实例..." "L_READING_INST")"; INST_IDS=(); INST_NAMES=(); INST_ADS=()
  local data
  data=$(o compute instance list -c "$TENANCY" --all \
    --query 'data[?"lifecycle-state"!=`"TERMINATED"`].["display-name","lifecycle-state",shape,id]' 2>/dev/null | jq -r '.[]|@tsv')
  [ -z "$data" ] && { echo "$(_t "无实例" "L_NO_INST")"; return 1; }
  echo "编号  名称                   状态      规格/配置                   公网IP           所在子网"
  local i=0
  while IFS=$'\t' read -r name state shape id; do
    [ "$INTR" = 1 ] && { INTR=0; break; }
    [ -z "$id" ] && continue; i=$((i+1))
    INST_IDS[$i]="$id"; INST_NAMES[$i]="$name"
    local pubip sid sname ad ocpu mem disk cfgstr
    pubip=$(o compute instance list-vnics --instance-id "$id" --query 'data[?"is-primary"]|[0]."public-ip"' --raw-output 2>/dev/null)
    sid=$(o compute instance list-vnics --instance-id "$id" --query 'data[?"is-primary"]|[0]."subnet-id"' --raw-output 2>/dev/null)
    sname=$(o network subnet get --subnet-id "$sid" --query 'data."display-name"' --raw-output 2>/dev/null)
    IFS=$'\t' read -r ad ocpu mem < <(o compute instance get --instance-id "$id" \
      --query 'data.["availability-domain","shape-config".ocpus,"shape-config"."memory-in-gbs"]' 2>/dev/null | jq -r '@tsv')
    INST_ADS[$i]="$ad"
    # 引导卷大小
    disk=$(o compute boot-volume-attachment list -c "$TENANCY" --availability-domain "$ad" --instance-id "$id" \
      --query 'data[?"lifecycle-state"==`"ATTACHED"`]."boot-volume-id" | [0]' --raw-output 2>/dev/null)
    [ -n "$disk" ] && disk=$(o bv boot-volume get --boot-volume-id "$disk" --query 'data."size-in-gbs"' --raw-output 2>/dev/null)
    # 挂载的块存储卷：显示为 引导卷+数据盘，如 200G+50G
    local dvn dvs dvi extra=""
    while IFS=$'\t' read -r dvn dvs dvi; do [ -n "$dvs" ] && extra="${extra}+${dvs}G"; done < <(_inst_data_vols "$id" "$ad")
    # 组合：简化 shape 名 + 核/内存/盘
    local shortshape="${shape#VM.Standard.}"
    cfgstr=$(printf "%s %s核/%sG/%sG%s" "$shortshape" "${ocpu%.*}" "${mem%.*}" "${disk:-?}" "$extra")
    printf "%-4s  %-20s %-9s %-24s %-15s %s\n" "$i" "$name" "$state" "$cfgstr" "${pubip:-—}" "${sname:-—}"
  done <<< "$data"
}
pick_instance(){ inst_list || return 1; local ii; _askc "$(_t "选择实例编号" "L_CHOOSE_INST")" ii || return 1; SEL_ID="${INST_IDS[$ii]}"; SEL_NAME="${INST_NAMES[$ii]}"; SEL_AD="${INST_ADS[$ii]}"; [ -z "$SEL_ID" ] && { echo "无效"; return 1; }; return 0; }
# ---- 通用辅助 ----
_is_int(){ [[ "$1" =~ ^[0-9]+$ ]]; }
_confirm(){ local c; _ask -rp "$1 (y/n): " c; [ "$c" = y ]; }
_inst_state(){ o compute instance get --instance-id "$1" --query 'data."lifecycle-state"' --raw-output 2>/dev/null; }
_inst_ip(){ local ip; ip=$(o compute instance list-vnics --instance-id "$1" --query 'data[?"is-primary"]|[0]."public-ip"' --raw-output 2>/dev/null); [ "$ip" = null ] && ip=""; echo "$ip"; }
# 从 OCI 报错里取出 message 首行
_oci_err(){ local m; m=$(echo "$1" | grep -m1 '"message"' | sed 's/.*"message": *"//;s/",*$//'); [ -z "$m" ] && m=$(echo "$1" | grep -m1 -i '^Error'); [ -z "$m" ] && m=$(echo "$1" | grep -v '^\s*$' | grep -v 'oci -i' | tail -1); echo "${m:0:150}"; }
# 轮询实例状态直到目标值。$1=id $2=目标 $3=最长秒数。stdout 输出最终状态
_wait_state(){
  local id="$1" want="$2" max="${3:-300}" t=0 st=""
  while [ "$t" -lt "$max" ]; do
    [ "$INTR" = 1 ] && { INTR=0; break; }
    st=$(_inst_state "$id")
    [ "$st" = "$want" ] && { echo >&2; echo "$st"; return 0; }
    printf '.' >&2; sleep 10; t=$((t+10))
  done
  echo >&2; echo "$st"; return 1
}
inst_action(){
  pick_instance || return
  local target; case "$1" in START|SOFTRESET|RESET) target=RUNNING;; *) target=STOPPED;; esac
  local cur; cur=$(_inst_state "$SEL_ID")
  if [ "$1" != SOFTRESET ] && [ "$1" != RESET ] && [ "$cur" = "$target" ]; then echo "$SEL_NAME 当前已是 $cur，无需操作。"; return; fi
  _confirm "确认对 $SEL_NAME（当前 $cur）执行「$2」？" || return
  local out t0=$SECONDS
  out=$(o compute instance action --instance-id "$SEL_ID" --action "$1" 2>&1) || { echo "失败：$(_oci_err "$out")"; notify "$2失败" "$SEL_NAME" "原因：$(_oci_err "$out")"; return; }
  echo "$(_t "已发送，等待状态变为 %s（最多5分钟，Ctrl+C 可中断）" "L_WAIT_STATE" "$target")"
  [ "$1" = SOFTRESET ] || [ "$1" = RESET ] && sleep 20
  local st ip dt; st=$(_wait_state "$SEL_ID" "$target" 300); ip=$(_inst_ip "$SEL_ID"); dt=$((SECONDS-t0))
  if [ "$st" = "$target" ]; then
    echo "$(_t "完成：%s  公网IP：%s  耗时：%s秒" "L_DONE_STATE" "$st" "${ip:-无}" "${dt}")"
    notify "$2成功" "$SEL_NAME" "状态：$st" "公网IP：${ip:-—}" "耗时：${dt}秒"
  else
    echo "未在时限内完成，当前状态：${st:-未知}"
    notify "$2失败" "$SEL_NAME" "原因：超时未达到 $target" "当前状态：${st:-未知}" "公网IP：${ip:-—}"
  fi
}
inst_change_shape(){
  pick_instance || return
  local shp oc0 mm0
  IFS=$'\t' read -r shp oc0 mm0 < <(o compute instance get --instance-id "$SEL_ID" --query 'data.[shape,"shape-config".ocpus,"shape-config"."memory-in-gbs"]' 2>/dev/null | jq -r '@tsv')
  [[ "$shp" == *Flex* ]] || { echo "$(_t "%s 不是 Flex 规格，不能改配置。" "L_NOT_FLEX" "$shp")"; return; }
  echo "$(_t "当前：%s核 / %sG（A1 免费上限：整个账号合计 4核/24G）" "L_CURR_CFG" "${oc0%.*}" "${mm0%.*}")"
  local ocpu mem; _ask -rp "新 OCPU: " ocpu; _ask -rp "新内存GB: " mem
  _is_int "$ocpu" && _is_int "$mem" && [ "$ocpu" -ge 1 ] && [ "$mem" -ge 1 ] || { echo "$(_t "输入必须是正整数" "L_MUST_POS_INT")"; return; }
  if [ "$ocpu" -gt 4 ] || [ "$mem" -gt 24 ]; then _ask -rp "$(_t "⚠️ 超出免费额度会产生费用，确认请输 yes: " "L_ASK_OVER_FREE")" c; [ "$c" = yes ] || return; fi
  _confirm "确认 $SEL_NAME：${oc0%.*}核/${mm0%.*}G → ${ocpu}核/${mem}G？（会重启一次）" || return
  local out t0=$SECONDS
  out=$(o compute instance update --instance-id "$SEL_ID" --shape-config "{\"ocpus\":$ocpu,\"memoryInGBs\":$mem}" --force 2>&1) || { echo "失败：$(_oci_err "$out")"; notify "改配置失败" "$SEL_NAME" "原因：$(_oci_err "$out")"; return; }
  echo "$(_t "已提交，等待实例重启完成（最多5分钟）" "L_WAIT_REBOOT")"; sleep 20
  local st ip oc1 mm1; st=$(_wait_state "$SEL_ID" RUNNING 300); ip=$(_inst_ip "$SEL_ID")
  IFS=$'\t' read -r oc1 mm1 < <(o compute instance get --instance-id "$SEL_ID" --query 'data.["shape-config".ocpus,"shape-config"."memory-in-gbs"]' 2>/dev/null | jq -r '@tsv')
  if [ "$st" = RUNNING ]; then
    echo "$(_t "完成：%s核/%sG  公网IP：%s  耗时：%s" "L_RESIZE_DONE" "${oc1%.*}" "${mm1%.*}" "${ip:-无}" "$((SECONDS-t0))秒")"
    notify "改配置成功" "$SEL_NAME" "变更：${oc0%.*}核/${mm0%.*}G → ${oc1%.*}核/${mm1%.*}G" "状态：$st" "公网IP：${ip:-—}"
  else
    echo "$(_t "未在时限内恢复运行，当前状态：%s" "L_REBOOT_TIMEOUT" "${st:-未知}")"
    notify "改配置失败" "$SEL_NAME" "原因：超时未恢复 RUNNING" "当前状态：${st:-未知}"
  fi
}
inst_delete(){
  pick_instance || return
  local ip; ip=$(_inst_ip "$SEL_ID")
  # 额外挂载的块存储卷：删实例后会保留并继续计费
  local vols; vols=$(o compute volume-attachment list -c "$TENANCY" --instance-id "$SEL_ID" --all 2>/dev/null \
    | jq -r '.data[]|select(."lifecycle-state"=="ATTACHED")|."volume-id"' 2>/dev/null)
  if [ -n "$vols" ]; then
    echo "$(_t "⚠️ 这台实例还挂着以下块存储卷，删实例后它们会保留并继续计费（可之后用 存储→7 删除）：" "L_ATTACHED_VOLS")"
    local v; while read -r v; do [ -z "$v" ] && continue
      o bv volume get --volume-id "$v" 2>/dev/null | jq -r '.data|"   \(."display-name")  \(."size-in-gbs")G"'; done <<< "$vols"
  fi
  _ask -rp "$(_t "确认永久删除 %s（公网IP %s）？输 yes 确认: " "L_ASK_DEL_INST" "$SEL_NAME" "${ip:-无}")" c; [ "$c" != yes ] && return
  # 和官网一样：询问是否一并删除引导卷
  local delbv="y"; _ask -rp "是否一并删除引导卷？(y=删除/n=保留，保留会继续计费) [y]: " delbv; delbv="${delbv:-y}"
  local preserve="false"; [ "$delbv" = "n" ] || [ "$delbv" = "N" ] && preserve="true"
  [ "$preserve" = "true" ] && echo "$(_t "⚠️ 引导卷将保留，之后仍会计费（可在 3引导卷 → 7删除未挂载的盘 清理）。" "L_BOOT_KEPT")"
  local out; out=$(o compute instance terminate --instance-id "$SEL_ID" --preserve-boot-volume "$preserve" --force 2>&1)
  if [ $? -eq 0 ]; then
    echo "$(_t "已提交，等待删除完成（最多5分钟）" "L_WAIT_DELETE")"; local st; st=$(_wait_state "$SEL_ID" TERMINATED 300)
    if [ "$st" = TERMINATED ]; then echo "$(_t "已删除。" "L_DELETED")"; notify "删除" "$SEL_NAME" "公网IP：${ip:-—}" "状态：TERMINATED"
    else echo "$(_t "未在时限内完成，当前：%s" "L_DELETE_TIMEOUT" "${st:-未知}")"; notify "删除失败" "$SEL_NAME" "原因：超时未完成删除" "当前状态：${st:-未知}"; fi
  else echo "失败：$(_oci_err "$out")"; notify "删除失败" "$SEL_NAME" "原因：$(_oci_err "$out")"; fi
}
inst_rename(){
  pick_instance || return
  local nn; _ask -rp "新名称: " nn; [ -z "$nn" ] && return
  _confirm "确认 $SEL_NAME → $nn？" || return
  local out; out=$(o compute instance update --instance-id "$SEL_ID" --display-name "$nn" --force 2>&1)
  local now; now=$(o compute instance get --instance-id "$SEL_ID" --query 'data."display-name"' --raw-output 2>/dev/null)
  if [ "$now" = "$nn" ]; then echo "$(_t "已改名为 %s" "L_RENAMED" "$nn")"; notify "改名" "$SEL_NAME" "新名称：$nn" "状态：已生效"
  else local e; e=$(_oci_err "$out"); [ -z "$e" ] && e="回读名称为 ${now:-空}"; echo "$(_t "失败：%s" "L_FAILED_E" "$e")"; notify "改名失败" "$SEL_NAME" "原因：$e"; fi
  pause
}
# 建默认网络：VCN+网关+路由+子网，回显子网OCID（失败返回1，进度走stderr）
# $1=VCN网段 $2=子网网段 $3=名称前缀
_create_default_network(){
  local vcn_cidr="${1:-10.0.0.0/16}" sub_cidr="${2:-10.0.0.0/24}" nprefix="${3:-oci-cn}"
  local vcn ig rt sub
  echo "$(_t "  建 VCN (%s)..." "L_BUILD_VCN" "$vcn_cidr")" >&2
  vcn=$(o network vcn create -c "$TENANCY" --cidr-block "$vcn_cidr" --display-name "${nprefix}-vcn" --query 'data.id' --raw-output 2>/dev/null)
  [[ "$vcn" == ocid1.vcn* ]] || return 1
  echo "$(_t "  建互联网网关..." "L_BUILD_IG")" >&2
  ig=$(o network internet-gateway create -c "$TENANCY" --is-enabled true --vcn-id "$vcn" --display-name "${nprefix}-ig" --query 'data.id' --raw-output 2>/dev/null)
  [[ "$ig" == ocid1.internetgateway* ]] || return 1
  echo "$(_t "  配路由..." "L_BUILD_RT")" >&2
  rt=$(o network route-table list -c "$TENANCY" --vcn-id "$vcn" --query 'data[0].id' --raw-output 2>/dev/null)
  o network route-table update --rt-id "$rt" --route-rules "[{\"cidrBlock\":\"0.0.0.0/0\",\"networkEntityId\":\"$ig\"}]" --force >/dev/null 2>&1
  echo "$(_t "  建子网 (%s)..." "L_BUILD_SUBNET" "$sub_cidr")" >&2
  sub=$(o network subnet create -c "$TENANCY" --vcn-id "$vcn" --cidr-block "$sub_cidr" --display-name "${nprefix}-subnet" --query 'data.id' --raw-output 2>/dev/null)
  [[ "$sub" == ocid1.subnet* ]] || return 1
  echo "$sub"
}
inst_create(){
  echo "$(_t "单次创建实例（失败即报错）" "L_CREATE_TITLE")"
  local ads; ads=$(o iam availability-domain list --query 'data[].name' 2>/dev/null | jq -r '.[]' 2>/dev/null)
  local ad; ad=$(head -1 <<< "$ads")
  if [ "$(grep -c . <<< "$ads")" -gt 1 ]; then
    echo "$(_t "可用域：" "L_AD_LIST")"; local k=0 x; local -a A=(); while read -r x; do [ -z "$x" ] && continue; k=$((k+1)); A[$k]="$x"; echo "   $k  $x"; done <<< "$ads"
    _askc "$(_t "选择可用域编号" "L_CHOOSE_AD")" x "1" || return; ad="${A[$x]}"
  else
    _askc "$(_t "可用域" "L_AD")" x "$ad" || return; ad="$x"
  fi
  [ -z "$ad" ] && { echo "$(_t "读取可用域失败" "L_AD_FAIL")"; return; }
  # 实例类型：免费额度 vs 付费（免费仅 E2.Micro/A1.Flex，但可用性走 API 实时查）
  echo "$(_t "实例类型: 1=免费额度(只显示E2.Micro/A1.Flex)  2=付费(全部机型)" "L_INST_TYPE")"; _askc "选择" insttype || return
  local freeonly=0
  case "$insttype" in 1) freeonly=1;; 2) freeonly=0;; *) echo "无效"; return;; esac
  # 机型：从 API 实时拉取该可用域全部可用规格（替代写死的二选一）
  echo "$(_t "读取可用机型（该可用域实时提供）..." "L_READING_SHAPES")"
  local shapes_json; shapes_json=$(o compute shape list -c "$TENANCY" --availability-domain "$ad" --all 2>/dev/null)
  local shapes; shapes=$(echo "$shapes_json" | jq -r '.data[] | [.shape, (.["processor-description"]//""), ((.ocpus//0)|tostring), ((.["memory-in-gbs"]//0)|tostring)] | @tsv' 2>/dev/null)
  [ -z "$shapes" ] && { echo "$(_t "无法读取机型列表，检查网络/权限" "L_SHAPES_FAIL")"; return; }
  local -a SHAPE=() SHPROC=() SHOCPU=() SHMEM=() SHFLEX=(); local i=0
  # 先收集全部，再分两批显示：免费机型置顶（仅付费模式），其余按原顺序
  local -a _ALL=()
  while IFS=$'\t' read -r sh proc ocpu mem; do
    [ -z "$sh" ] && continue
    # 免费模式：只保留 E2.Micro 和 A1.Flex
    if [ "$freeonly" = 1 ]; then
      case "$sh" in VM.Standard.E2.1.Micro|VM.Standard.A1.Flex) ;; *) continue;; esac
    fi
    _ALL+=("$sh"$'\t'"$proc"$'\t'"$ocpu"$'\t'"$mem")
  done <<< "$shapes"
  local -a _ORDERED=()
  if [ "$freeonly" = 0 ]; then
    # 付费模式：免费机型置顶
    for _e in "${_ALL[@]}"; do case "${_e%%$'\t'*}" in VM.Standard.E2.1.Micro|VM.Standard.A1.Flex) _ORDERED+=("$_e");; esac; done
  fi
  for _e in "${_ALL[@]}"; do
    local _sh="${_e%%$'\t'*}"
    case "$_sh" in VM.Standard.E2.1.Micro|VM.Standard.A1.Flex) [ "$freeonly" = 0 ] && continue;; esac
    _ORDERED+=("$_e")
  done
  for _e in "${_ORDERED[@]}"; do
    IFS=$'\t' read -r sh proc ocpu mem <<< "$_e"
    i=$((i+1))
    SHAPE[$i]="$sh"; SHPROC[$i]="$proc"
    # Flex 机型：名字含 .Flex，可自定义核/内存（API 返回的是默认值，不能当固定规格）
    if [[ "$sh" == *.Flex ]]; then SHFLEX[$i]=1; SHOCPU[$i]=""; SHMEM[$i]=""
    else SHFLEX[$i]=0; SHOCPU[$i]="${ocpu%.*}"; SHMEM[$i]="${mem%.*}"; fi
    local spec ftag=""
    if [ "${SHFLEX[$i]}" = 1 ]; then spec="Flex(自定义核/内存)"; else spec="${SHOCPU[$i]}核/${SHMEM[$i]}G"; fi
    case "$sh" in VM.Standard.E2.1.Micro|VM.Standard.A1.Flex)
      if [ "${OCI_REGION}" = "${HOME_REGION:-$OCI_REGION}" ]; then ftag=" [免费]"
      else ftag=" [副区域计费]"; fi;; esac
    printf "  %2s  %-28s %-18s %s%s\n" "$i" "$sh" "$spec" "$proc" "$ftag"
  done
  if [ "$i" -eq 0 ]; then
    if [ "$freeonly" = 1 ]; then echo "$(_t "❌ 该可用域（%s）不提供免费机型（E2.Micro/A1.Flex），换可用域或选付费。" "L_NO_FREE_SHAPE" "${ad##*:}")"; else echo "$(_t "该可用域无可用机型" "L_NO_SHAPES")"; fi
    return
  fi
  local si; _askc "$(_t "选择机型编号" "L_CHOOSE_SHAPE")" si || return; local shape="${SHAPE[$si]}"; [ -z "$shape" ] && { echo "无效"; return; }
  local shapecfg="" oc="1" mm="1" cfgdesc
  if [ "${SHFLEX[$si]}" = 1 ]; then
    # 从 API 实时获取该 Flex 机型的官方约束（min/max OCPU、min/max 内存）
    echo "$(_t "读取 %s 官方规格约束..." "L_READING_CONSTRAINTS" "$shape")"
    local shape_detail; shape_detail=$(o compute shape get -c "$TENANCY" --availability-domain "$ad" --shape-name "$shape" 2>/dev/null)
    local min_ocpu=1 max_ocpu=64 min_mem_per_ocpu=1 max_mem_per_ocpu=64
    if [ -n "$shape_detail" ]; then
      local _v
      _v=$(echo "$shape_detail" | jq -r '.data."ocpu-options"."min-in-gbs // .data."ocpu-options".min // empty' 2>/dev/null); [ -n "$_v" ] && min_ocpu="${_v%.*}"
      _v=$(echo "$shape_detail" | jq -r '.data."ocpu-options".max // empty' 2>/dev/null); [ -n "$_v" ] && max_ocpu="${_v%.*}"
      _v=$(echo "$shape_detail" | jq -r '.data."memory-options"."min-per-ocpu-in-gbs" // empty' 2>/dev/null); [ -n "$_v" ] && min_mem_per_ocpu="${_v%.*}"
      _v=$(echo "$shape_detail" | jq -r '.data."memory-options"."max-per-ocpu-in-gbs" // empty' 2>/dev/null); [ -n "$_v" ] && max_mem_per_ocpu="${_v%.*}"
    fi
    echo "  约束：OCPU ${min_ocpu}~${max_ocpu}，内存每核 ${min_mem_per_ocpu}~${max_mem_per_ocpu}G"
    _askc "$(_t "OCPU数量" "L_OCPU_COUNT")" oc || return; _askc "$(_t "内存GB" "L_MEMORY_GB")" mm || return
    _is_int "$oc" && _is_int "$mm" && [ "$oc" -ge 1 ] && [ "$mm" -ge 1 ] || { echo "$(_t "OCPU/内存必须是正整数" "L_OCPU_MEM_INT")"; return; }
    [ "$oc" -lt "$min_ocpu" ] || [ "$oc" -gt "$max_ocpu" ] && { echo "$(_t "❌ OCPU 必须在 %s~%s 之间（官方约束）" "L_OCPU_RANGE" "${min_ocpu}" "${max_ocpu}")"; return; }
    local _min_mem=$((oc * min_mem_per_ocpu)); [ "$_min_mem" -lt 1 ] && _min_mem=1
    local _max_mem=$((oc * max_mem_per_ocpu))
    { [ "$mm" -lt "$_min_mem" ] || [ "$mm" -gt "$_max_mem" ]; } && { echo "❌ ${oc}核内存必须在 ${_min_mem}~${_max_mem}G 之间（官方约束：每核 ${min_mem_per_ocpu}~${max_mem_per_ocpu}G）"; return; }
    if [ "$shape" = "VM.Standard.A1.Flex" ] && { [ "$oc" -gt 4 ] || [ "$mm" -gt 24 ]; }; then
      _ask -rp "⚠️ 超出免费额度（4核/24G）会收费，确认输 yes: " c; [ "$c" = yes ] || return
    fi
    shapecfg="--shape-config {\"ocpus\":$oc,\"memoryInGBs\":$mm}"; cfgdesc="${oc}核/${mm}G"
  else
    cfgdesc="${SHOCPU[$si]}核/${SHMEM[$si]}G"
  fi
  # 预检查：所选机型在该可用域的配额（仅对已知免费规格做精确检查，其他依赖 API 报错）
  echo "$(_t "检查额度..." "L_CHECK_QUOTA")"
  local lname="" need=0
  case "$shape" in
    VM.Standard.E2.1.Micro) lname="standard-e2-micro-core-count"; need=1;;
    VM.Standard.A1.Flex) lname="standard-a1-core-count"; need="$oc";;
  esac
  if [ -n "$lname" ]; then
    local u a; IFS=$'\t' read -r u a < <(_limit_avail "$lname" "$ad")
    if [ -n "$a" ] && [ "${a%.*}" -lt "$need" ]; then echo "❌ 额度不足：$lname 已用 ${u%.*}，可用 ${a%.*}，本次需要 $need。"; return; fi
  fi
  # 引导卷大小：检查已有存储卷（引导卷+块存储卷，未挂载仍产生费用）+ 动态阈值
  echo "$(_t "检查已有存储卷（引导卷+块存储卷，未挂载仍产生费用）..." "L_CHECK_VOLS")"
  local bv_used=0 bv_count=0 bv_detail=""
  # 引导卷
  local _szs; _szs=$(o bv boot-volume list -c "$TENANCY" --query 'data[].["size-in-gbs","display-name"]' 2>/dev/null | jq -r '.[]|@tsv' 2>/dev/null)
  while IFS=$'\t' read -r _sz _nm; do
    [ -z "$_sz" ] && continue; bv_used=$((bv_used + ${_sz%.*})); bv_count=$((bv_count+1))
    bv_detail="${bv_detail}引导卷:${_nm:-?}(${_sz%.*}G) "
  done <<< "$_szs"
  # 块存储卷
  _szs=$(o bv volume list -c "$TENANCY" --query 'data[].["size-in-gbs","display-name"]' 2>/dev/null | jq -r '.[]|@tsv' 2>/dev/null)
  while IFS=$'\t' read -r _sz _nm; do
    [ -z "$_sz" ] && continue; bv_used=$((bv_used + ${_sz%.*})); bv_count=$((bv_count+1))
    bv_detail="${bv_detail}块存储:${_nm:-?}(${_sz%.*}G) "
  done <<< "$_szs"
  if [ "$bv_count" -gt 0 ]; then
    echo "$(_t "  已有存储卷 %s 个，合计 %sG（含未挂载卷，仍计入费用）" "L_VOLS_SUMMARY" "${bv_count}" "${bv_used}")"
    echo "$(_t "  明细：%s" "L_VOLS_DETAIL" "$bv_detail")"
    if [ "$bv_used" -gt 200 ]; then
      echo "$(_t "  ⚠️ 已超过免费额度 200G，继续创建将产生费用。" "L_OVER_FREE")"
      echo "$(_t "     可返回主菜单 → 3引导卷 → 7删除未挂载的盘，释放额度后再创建。" "L_FREE_HINT")"
    fi
  else
    echo "$(_t "  该租户暂无存储卷" "L_NO_VOLS")"
  fi
  local bvsz; _ask -rp "引导卷大小GB（留空=镜像默认，最小50，输 0 取消）: " bvsz; [ "$bvsz" = "0" ] && { echo "$(_t "已取消" "L_CANCELLED")"; return; }
  local bvopt=""
  if [ -n "$bvsz" ]; then
    _is_int "$bvsz" && [ "$bvsz" -ge 50 ] || { echo "$(_t "必须是 ≥50 的整数" "L_GE_50")"; return; }
    local bv_total=$((bv_used + bvsz))
    if [ "$bvsz" -gt 500 ]; then _ask -rp "$(_t "⚠️ 单盘超过500G，确认输 yes: " "L_ASK_OVER500")" c; [ "$c" = yes ] || return; fi
    if [ "$bv_total" -gt 200 ]; then _ask -rp "⚠️ 加上已有 ${bv_used}G，合计 ${bv_total}G 超过免费额度200G会收费，确认输 yes: " c; [ "$c" = yes ] || return; fi
    bvopt="--boot-volume-size-in-gbs $bvsz"
  fi
  # 子网：编号选择；没有则自动建
  echo "$(_t "读取子网..." "L_READING_SUBNETS")"
  local subs; subs=$(o network subnet list -c "$TENANCY" --query 'data[].["display-name",id]' 2>/dev/null | jq -r '.[]|@tsv')
  local subnet="" subname=""
  if [ -z "$subs" ]; then
    echo "$(_t "该区域没有子网（新账号/新区域）。" "L_NO_SUBNETS")"
    _confirm "自动创建默认网络（VCN+子网+网关+放行）？" || return
    local vcn_cidr sub_cidr nprefix
    _askc "$(_t "VCN 网段" "L_VCN_CIDR")" vcn_cidr "10.0.0.0/16" || return
    _askc "$(_t "子网网段" "L_SUBNET_CIDR")" sub_cidr "10.0.0.0/24" || return
    _askc "$(_t "名称前缀" "L_NAME_PREFIX")" nprefix "oci-cn" || return
    subnet=$(_create_default_network "$vcn_cidr" "$sub_cidr" "$nprefix") || { echo "$(_t "建网络失败" "L_NET_FAIL")"; return; }
    subname="${nprefix}-subnet（自动创建）"; echo "$(_t "默认网络已建，子网就绪。" "L_NET_READY")"
  else
    local -a SUBID=() SUBNM=(); local i=0
    while IFS=$'\t' read -r sn sid; do [ -z "$sid" ] && continue; i=$((i+1)); SUBID[$i]="$sid"; SUBNM[$i]="$sn"; printf "  %s  %s\n" "$i" "$sn"; done <<< "$subs"
    _askc "$(_t "选择子网编号" "L_CHOOSE_SUBNET")" si || return; subnet="${SUBID[$si]}"; subname="${SUBNM[$si]}"; [ -z "$subnet" ] && { echo "无效"; return; }
  fi
  # 镜像
  echo "$(_t "读取可用系统镜像（该区域实际可用）..." "L_READING_IMAGES")"
  local imgs; imgs=$(o compute image list -c "$TENANCY" --shape "$shape" --sort-by TIMECREATED --sort-order DESC \
    --query 'data[].["display-name",id]' 2>/dev/null | jq -r '.[]|@tsv')
  [ -z "$imgs" ] && { echo "$(_t "无可用镜像" "L_NO_IMAGES")"; return; }
  local -a IMGID=() IMGNM=(); i=0
  while IFS=$'\t' read -r inm iid; do
    [ -z "$iid" ] && continue; i=$((i+1)); IMGID[$i]="$iid"; IMGNM[$i]="$inm"; printf "  %s  %s\n" "$i" "$inm"
  done <<< "$imgs"
  echo "（共 $i 个镜像，按发布时间倒序）"
  _askc "$(_t "选择系统编号" "L_CHOOSE_IMAGE")" ii2 || return; local image="${IMGID[$ii2]}" imgname="${IMGNM[$ii2]}"; [ -z "$image" ] && { echo "无效"; return; }
  # 公钥 + 名称
  echo "$(_t "粘贴 SSH 公钥（ssh-ed25519... 或 ssh-rsa...，一行）：" "L_PASTE_PUBKEY")"
  _ask -r pubkey
  [[ "$pubkey" == ssh-* ]] || { echo "$(_t "不是有效公钥" "L_INVALID_PUBKEY")"; return; }
  local iname; _askc "$(_t "实例名" "L_INST_NAME")" iname || return; [ -z "$iname" ] && { echo "$(_t "实例名不能为空" "L_NAME_REQUIRED")"; return; }
  # 汇总确认
  line
  echo "  实例名：$iname"
  echo "  规格：  $shape  $cfgdesc"
  echo "  硬盘：  ${bvsz:-默认约47}G"
  echo "  系统：  $imgname"
  echo "  子网：  $subname"
  echo "  可用域：$ad"
  line
  _confirm "确认创建？" || return
  echo "$(_t "创建中..." "L_CREATING")"
  local meta; meta=$(jq -nc --arg k "$pubkey" '{ssh_authorized_keys:$k}')
  local out newid t0=$SECONDS
  out=$(o compute instance launch --availability-domain "$ad" -c "$TENANCY" --shape "$shape" $shapecfg $bvopt \
    --subnet-id "$subnet" --image-id "$image" --display-name "$iname" \
    --metadata "$meta" --assign-public-ip true --query 'data.id' --raw-output 2>&1)
  newid=$(echo "$out" | grep -m1 '^ocid1.instance')
  if [ -z "$newid" ]; then
    echo "失败：$(_oci_err "$out")"; notify "创建失败" "$iname" "规格：$cfgdesc" "原因：$(_oci_err "$out")"; return
  fi
  echo "已提交，等待实例运行（最多10分钟）"
  local st ip; st=$(_wait_state "$newid" RUNNING 600); ip=$(_inst_ip "$newid")
  if [ "$st" = RUNNING ]; then
    echo "创建完成：$iname  公网IP：${ip:-无}  耗时：$((SECONDS-t0))秒"
    notify "创建成功" "$iname" "规格：$cfgdesc / 硬盘${bvsz:-47}G" "系统：$imgname" "公网IP：${ip:-—}" "状态：RUNNING"
  else
    echo "已创建但未在时限内运行，当前状态：${st:-未知}"
    notify "创建失败" "$iname" "原因：超时未达到 RUNNING" "当前状态：${st:-未知}"
  fi
}

# ============ IP ============
_primary_pip(){ local vnic; vnic=$(o compute instance list-vnics --instance-id "$1" --query 'data[0].id' --raw-output); o network private-ip list --vnic-id "$vnic" --query 'data[?"is-primary"].id|[0]' --raw-output; }
inst_change_ip(){
  pick_instance || return; local pip; pip=$(_primary_pip "$SEL_ID")
  local oid life oip cid
  IFS=$'\t' read -r oid life oip < <(o network public-ip get --private-ip-id "$pip" --query 'data.[id,lifetime,"ip-address"]' 2>/dev/null | jq -r '@tsv')
  [ "$life" = "RESERVED" ] && { echo "保留IP（$oip），不更换。"; return; }
  local cfnote=""; [ -f "$CF_FILE" ] && { local _d; _d=$(sed -n '4p' "$CF_FILE"); cfnote="，${_d:-域名}中指向它的DNS记录会自动改"; }
  _confirm "确认更换 $SEL_NAME 的公网IP（当前 ${oip:-无}${cfnote}）？" || return
  cid=$(o compute instance get --instance-id "$SEL_ID" --query 'data."compartment-id"' --raw-output)
  [ -n "$oid" ] && [ "$oid" != null ] && { o network public-ip delete --public-ip-id "$oid" --force >/dev/null 2>&1; echo "已释放旧IP $oip"; }
  local i new
  for i in 1 2 3; do [ "$INTR" = 1 ] && { INTR=0; echo 已中断; return; }; sleep 4; new=$(o network public-ip create -c "$cid" --lifetime EPHEMERAL --private-ip-id "$pip" --query 'data."ip-address"' --raw-output 2>/dev/null) && { local chk; chk=$(_inst_ip "$SEL_ID"); echo "新IP：$new（回读：${chk:-未取到}）"; notify "换IP成功" "$SEL_NAME" "旧IP：${oip}" "新IP：${new}" "状态：$([ "$chk" = "$new" ] && echo 已绑定 || echo "已分配，回读为 ${chk:-空}")"; cf_update_ip "$oip" "$new"; return; }; echo "第 $i 次失败，重试..."; done
  echo "分配失败。"; notify "换IP失败" "$SEL_NAME"
}
inst_ipv6(){
  pick_instance || return
  _confirm "确认给 $SEL_NAME 附加一个 IPv6 地址？（子网需已启用IPv6）" || return
  local vnic out; vnic=$(o compute instance list-vnics --instance-id "$SEL_ID" --query 'data[0].id' --raw-output)
  out=$(o network ipv6 create --vnic-id "$vnic" --query 'data."ip-address"' --raw-output 2>&1)
  local v6; v6=$(echo "$out" | grep -m1 ':' | grep -v '"' )
  if [[ "$v6" == *:* ]]; then echo "已附加：$v6"; notify "附IPv6成功" "$SEL_NAME" "新IPv6：$v6" "状态：已分配"
  else echo "失败：$(_oci_err "$out")"; notify "附IPv6失败" "$SEL_NAME" "原因：$(_oci_err "$out")"; fi
}

