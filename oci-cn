# 设置整租户月度预算 + 50/80/100 三档告警邮件
budget_alert(){
  local ef="$EMAIL_DIR/$ACC_NAME"
  local email; email=$(cat "$ef" 2>/dev/null)
  [ -z "$email" ] && { echo "本账号($ACC_NAME)还没设告警邮箱，请先在成本分析里选「设置本账号邮箱」"; return; }
  echo "本账号告警邮箱：$email"
  local hr="${HOME_REGION:-$OCI_REGION}"
  local O="oci --config-file $OCI_CFG --region $hr"
  # 先查已有预算
  echo "$(_t "查询已有预算..." "L_QUERY_BUDGET")"
  local existing; existing=$($O budgets budget budget list -c "$TENANCY" --all \
    --query 'data[].[id,"display-name",amount,"reset-period"]' 2>/dev/null | jq -r '.[]|@tsv' 2>/dev/null)
  if [ -n "$existing" ]; then
    echo "$(_t "已存在预算：" "L_BUDGET_EXISTS")"
    local -a BIDS=(); local n=0
    while IFS=$'\t' read -r bid bname bamt bperiod; do
      [ -z "$bid" ] && continue; n=$((n+1)); BIDS[$n]="$bid"
      # 列出该预算的告警档位
      local rules; rules=$($O budgets budget alert-rule list --budget-id "$bid" --all \
        --query 'data[].threshold' 2>/dev/null | jq -r 'map(floor)|unique|sort|join("/")' 2>/dev/null)
      printf "  %s  金额 %s  周期 %s  告警 %s%%\n" "$n" "$bamt" "$bperiod" "${rules:-无}"
    done <<< "$existing"
    echo
    echo "$(_t "该租户已有预算。选择操作：" "L_BUDGET_CHOOSE")"
    echo " 1 保持不动   2 删除全部重建   0 取消"
    _ask -rp "$(_t "选择: " "L_ASK_CHOOSE")" op
    case "$op" in
      1) echo "保持不动。"; return;;
      2) local k; for k in $(seq 1 $n); do
           $O budgets budget budget delete --budget-id "${BIDS[$k]}" --force >/dev/null 2>&1 && echo "  已删除预算 $k"
         done;;
      *) return;;
    esac
  fi
  # 新建
  _ask -rp "月度预算金额（整租户，如 5）: " amount
  [ -z "$amount" ] && return
  echo "$(_t "创建预算中..." "L_CREATING_BUDGET")"
  local bid; bid=$($O budgets budget budget create \
    --compartment-id "$TENANCY" --amount "$amount" --reset-period MONTHLY \
    --target-type COMPARTMENT --targets "[\"$TENANCY\"]" \
    --display-name "oci-cn-budget" \
    --query 'data.id' --raw-output 2>&1)
  if [[ "$bid" != ocid1.budget* ]]; then
    echo "$(_t "创建预算失败：" "L_BUDGET_FAIL")"; echo "$bid" | tail -3; return
  fi
  echo "$(_t "预算已建。设置告警档位..." "L_BUDGET_DONE")"
  local p
  for p in 50 80 100; do
    $O budgets budget alert-rule create \
      --budget-id "$bid" --type ACTUAL --threshold "$p" --threshold-type PERCENTAGE \
      --recipients "$email" --display-name "alert-$p" \
      --message "预算已使用 $p%" >/dev/null 2>&1 && echo "  ✓ $p% 告警已设" || echo "  ✗ $p% 告警失败"
  done
  echo "$(_t "完成。达到 50/80/100%% 会发邮件到 %s" "L_BUDGET_ALERT_DONE" "$email")"
}

