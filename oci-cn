  _ask -rp "$(_t "大小GB[50]（最小50）（输 0 返回）: " "L_ASK_VOL_SIZE")" sz; [ "$sz" = "0" ] && { echo "$(_t "已取消" "L_CANCELLED")"; return; }; sz="${sz:-50}"; _is_int "$sz" && [ "$sz" -ge 50 ] || { echo "$(_t "必须是 ≥50 的整数" "L_GE_50")"; return; }
  _ask -rp "$(_t "VPU[10]（0/10/20…120）（输 0 返回）: " "L_ASK_VOL_VPU")" vp; [ "$vp" = "0" ] && { echo "$(_t "已取消" "L_CANCELLED")"; return; }; vp="${vp:-10}"; _is_int "$vp" && [ $((vp%10)) -eq 0 ] && [ "$vp" -le 120 ] || { echo "$(_t "VPU 无效" "L_VPU_INVALID")"; return; }
  # 计费预估：统计当前区域已用
  local used=0 t id n s v a
  while IFS=$'\t' read -r t id n s v a; do [ -n "$s" ] && used=$((used+s)); done < <(_scan_region_disks "$r")
  local bill
