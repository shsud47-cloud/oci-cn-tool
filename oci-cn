  _show_effective
}
# 显示 SEL_ID/SEL_NAME 实例生效的安全列表与 NSG 入站规则（交互菜单与 --list-rules CLI 共用）
# 依赖全局量：SEL_ID SEL_NAME ACC_NAME OCI_REGION OCI_CFG
_show_effective(){
  local sid; sid=$(o compute instance list-vnics --instance-id "$SEL_ID" --query 'data[?"is-primary"]|[0]."subnet-id"' --raw-output)
  local sname; sname=$(o network subnet get --subnet-id "$sid" --query 'data."display-name"' --raw-output)
  echo "实例 $SEL_NAME → 子网 $sname"; line
  local push_rules=""
  local sls; sls=$(o network subnet get --subnet-id "$sid" --query 'data."security-list-ids"' 2>/dev/null | jq -r '.[]')
  for slid in $sls; do
    local slname; slname=$(o network security-list get --security-list-id "$slid" --query 'data."display-name"' --raw-output)
    echo "[安全列表：$slname] 入站："
    local r; r=$(o network security-list get --security-list-id "$slid" --query 'data."ingress-security-rules"' 2>/dev/null | _fmt_rules)
    echo "$r"
    push_rules="${push_rules}$(echo "$r" | sed 's/^  //;s/$/  /')
"
  done
  local nsgs; nsgs=$(o compute instance list-vnics --instance-id "$SEL_ID" --query 'data[0]."nsg-ids"' 2>/dev/null | jq -r '.[]?')
  for ng in $nsgs; do
    [ -z "$ng" ] && continue
    local ngn; ngn=$(o network nsg get --nsg-id "$ng" --query 'data."display-name"' --raw-output)
    echo "[NSG：$ngn] 入站："
    o network nsg rules list --nsg-id "$ng" --query 'data[?direction==`"INGRESS"`]' 2>/dev/null | _fmt_rules
  done
  notify "查看端口规则" "$SEL_NAME" "子网：$sname" "入站规则：
${push_rules}"
}
# 解析规则：协议名 + 端口 + 来源（表头与"全部"走双语）
_fmt_rules(){
  local _all _h1 _h2 _h3
  _all="$(_t "全部" "L_PROTO_ALL")"; _h1="$(_t "协议" "L_COL_PROTO")"
  _h2="$(_t "端口" "L_COL_PORT")"; _h3="$(_t "来源" "L_COL_SRC")"
  jq -r --arg all "$_all" '.[] |
    ( if .protocol=="6" then "TCP"
      elif .protocol=="17" then "UDP"
      elif .protocol=="1" then "ICMP"
      elif .protocol=="all" then $all
      else .protocol end ) as $p |
    ( (."tcp-options"."destination-port-range" // ."tcpOptions"."destinationPortRange" // ."udp-options"."destination-port-range" // ."udpOptions"."destinationPortRange") as $r |
      if $r==null then (if .protocol=="6" or .protocol=="17" then $all else "-" end)
      elif $r.min==$r.max then ($r.min|tostring)
      else "\($r.min)-\($r.max)" end ) as $port |
    [$p, $port, .source] | @tsv' 2>/dev/null \
  | awk -F'\t' -v h1="$_h1" -v h2="$_h2" -v h3="$_h3" 'BEGIN{printf "  %-6s %-12s %s\n",h1,h2,h3} {printf "  %-6s %-12s %s\n",$1,$2,$3}'
}
# 取选中实例所挂子网绑定的安全列表，列出让用户确认或改选 -> 设 SEL_SLID / SEL_SLNAME
_pick_seclist(){
  local sid; sid=$(o compute instance list-vnics --instance-id "$SEL_ID" --query 'data[?"is-primary"]|[0]."subnet-id"' --raw-output 2>/dev/null)
  local sname; sname=$(o network subnet get --subnet-id "$sid" --query 'data."display-name"' --raw-output 2>/dev/null)
  local ids; ids=$(o network subnet get --subnet-id "$sid" --query 'data."security-list-ids"' 2>/dev/null | jq -r '.[]')
  local -a arr=(); local n=0 x
  for x in $ids; do n=$((n+1)); arr[$n]="$x"; done
  if [ "$n" -eq 0 ]; then echo "子网 $sname 未绑定安全列表"; return 1; fi
  echo "实例所在子网 $sname 绑定的安全列表："
  local k
  for k in $(seq 1 $n); do
    local nm; nm=$(o network security-list get --security-list-id "${arr[$k]}" --query 'data."display-name"' --raw-output 2>/dev/null)
    local def=""; [ "$k" = 1 ] && def="  ← 默认"
    echo "  $k  $nm$def"
  done
  _ask -rp "$(_t "回车用默认(1)，或输编号改选: " "L_ASK_DEFAULT1")" sel
  [ -z "$sel" ] && sel=1
  SEL_SLID="${arr[$sel]}"; [ -z "$SEL_SLID" ] && { echo "无效"; return 1; }
  SEL_SLNAME=$(o network security-list get --security-list-id "$SEL_SLID" --query 'data."display-name"' --raw-output 2>/dev/null)
  return 0
}
# 显示某安全列表的入站规则（带编号），供开放/关闭复用
_show_rules(){  # $1=slid
  local cur; cur=$(o network security-list get --security-list-id "$1" --query 'data."ingress-security-rules"' 2>/dev/null)
  echo "$(_t "当前入站规则：" "L_CUR_RULES")"
  local _all _pw _src
  _all="$(_t "全部" "L_PROTO_ALL")"; _pw="$(_t "端口" "L_COL_PORT")"; _src="$(_t "来源" "L_COL_SRC")"
  echo "$cur" | jq -r --arg all "$_all" --arg pw "$_pw" --arg src "$_src" 'to_entries[] |
    ( if .value.protocol=="6" then "TCP" elif .value.protocol=="17" then "UDP"
      elif .value.protocol=="1" then "ICMP" elif .value.protocol=="all" then $all
      else .value.protocol end ) as $p |
    ( (.value."tcp-options"."destination-port-range" // .value."tcpOptions"."destinationPortRange" // .value."udp-options"."destination-port-range" // .value."udpOptions"."destinationPortRange") as $r |
      if $r==null then (if .value.protocol=="6" or .value.protocol=="17" then $all else "-" end)
      elif $r.min==$r.max then ($r.min|tostring) else "\($r.min)-\($r.max)" end ) as $port |
    "  [\(.key)] \($p)  \($pw) \($port)  \($src) \(.value.source)"' 2>/dev/null
  [ -z "$cur" ] || [ "$cur" = "[]" ] && echo "  $(_t "（无规则）" "L_NO_RULES")"
}
net_open_port(){
  pick_instance || return
  _pick_seclist || return
  local slid="$SEL_SLID"
  echo "将修改：$SEL_SLNAME（同子网所有实例生效）"
  _show_rules "$slid"
  _ask -rp "协议(tcp/udp/all): " proto
  case "$proto" in tcp|udp|all) ;; *) echo "协议只能是 tcp/udp/all"; return;; esac
  local port="" pmin=1 pmax=65535
  if [ "$proto" != all ]; then
    _ask -rp "端口(如443或8000-8100): " port
    if [[ "$port" == *-* ]]; then pmin="${port%-*}"; pmax="${port#*-}"; else pmin="$port"; pmax="$port"; fi
    _is_int "$pmin" && _is_int "$pmax" && [ "$pmin" -ge 1 ] && [ "$pmax" -le 65535 ] && [ "$pmin" -le "$pmax" ] || { echo "端口无效（1-65535）"; return; }
  else port="全部"; fi
  local newrule
  case "$proto" in
    all) newrule='{"protocol":"all","source":"0.0.0.0/0","isStateless":false}';;
    udp) newrule="{\"protocol\":\"17\",\"source\":\"0.0.0.0/0\",\"isStateless\":false,\"udpOptions\":{\"destinationPortRange\":{\"min\":$pmin,\"max\":$pmax}}}";;
    *)   newrule="{\"protocol\":\"6\",\"source\":\"0.0.0.0/0\",\"isStateless\":false,\"tcpOptions\":{\"destinationPortRange\":{\"min\":$pmin,\"max\":$pmax}}}";;
  esac
  local cur merged
  cur=$(o network security-list get --security-list-id "$slid" --query 'data."ingress-security-rules"' 2>/dev/null)
  merged=$(echo "$cur" | jq -c ". + [$newrule]")
  # v6.5：执行前先展示执行后的完整规则（diff 确认）
  local _n; _n=$(echo "$merged" | jq 'length' 2>/dev/null || echo "?")
  echo "$(_t "将开放 %s %s（来源0.0.0.0/0），执行后入站规则将变为（共 %s 条）：" "L_AFTER_RULES" "$proto" "$port" "${_n}")"
  echo "$merged" | _fmt_rules
  _confirm "$(_t "确认执行以上变更？（同子网所有实例生效）" "L_CONFIRM_APPLY")" || { echo "$(_t "已取消" "L_CANCELLED")"; return; }
  local out; out=$(o network security-list update --security-list-id "$slid" --ingress-security-rules "$merged" --force 2>&1)
  if [ $? -eq 0 ]; then echo "已开放 $proto $port"; notify "开放端口成功" "$SEL_NAME" "端口：$proto $port" "状态：已生效，当前入站规则 $(_sl_count "$slid") 条"
  else echo "失败：$(_oci_err "$out")"; notify "开放端口失败" "$SEL_NAME" "端口：$proto $port" "原因：$(_oci_err "$out")"; fi
}
# 回读安全列表入站规则条数
_sl_count(){ o network security-list get --security-list-id "$1" --query 'length(data."ingress-security-rules")' --raw-output 2>/dev/null; }
net_open_all(){
  pick_instance || return
  _pick_seclist || return
  local slid="$SEL_SLID"
  _ask -rp "$(_t "确认放行全部端口？安全列表 %s，同子网所有实例生效 (yes/n): " "L_ASK_OPEN_ALL" "$SEL_SLNAME")" c; [ "$c" != yes ] && return
  local out; out=$(o network security-list update --security-list-id "$slid" --ingress-security-rules '[{"protocol":"all","source":"0.0.0.0/0","isStateless":false}]' --force 2>&1)
  if [ $? -eq 0 ]; then echo "已放行。"; notify "放行全部" "$SEL_NAME" "已放行所有端口（原规则已替换）" "状态：已生效，当前入站规则 $(_sl_count "$slid") 条"
  else echo "失败：$(_oci_err "$out")"; notify "放行全部失败" "$SEL_NAME" "原因：$(_oci_err "$out")"; fi
}
net_close_port(){
  pick_instance || return
  _pick_seclist || return
  local slid="$SEL_SLID"
  echo "安全列表：$SEL_SLNAME"
  local cur; cur=$(o network security-list get --security-list-id "$slid" --query 'data."ingress-security-rules"' 2>/dev/null)
  _show_rules "$slid"
  _ask -rp "输入要删除的编号（多个用空格）: " nums
  [ -z "$nums" ] && return
  local delexpr="["; for n in $nums; do delexpr+="$n,"; done; delexpr="${delexpr%,}]"
  local merged; merged=$(echo "$cur" | jq -c "del(.[$delexpr[]])" 2>/dev/null)
  [ -z "$merged" ] && { echo "编号有误"; return; }
  # v6.5：执行前先展示删除后的完整规则（diff 确认）
  local _n; _n=$(echo "$merged" | jq 'length' 2>/dev/null || echo "?")
  echo "$(_t "将删除规则编号：%s，删除后入站规则将变为（剩余 %s 条）：" "L_AFTER_DEL_RULES" "$nums" "${_n}")"
  echo "$merged" | _fmt_rules
  _ask -rp "$(_t "确认删除？同子网所有实例生效 (y/n): " "L_CONFIRM_DEL")" c; [ "$c" != y ] && { echo "$(_t "已取消" "L_CANCELLED")"; return; }
  local out; out=$(o network security-list update --security-list-id "$slid" --ingress-security-rules "$merged" --force 2>&1)
  if [ $? -eq 0 ]; then echo "$(_t "已删除。" "L_DELETED")"; notify "关闭端口成功" "$SEL_NAME" "已删除规则编号：$nums" "状态：已生效，当前入站规则 $(_sl_count "$slid") 条"
  else echo "失败：$(_oci_err "$out")"; notify "关闭端口失败" "$SEL_NAME" "原因：$(_oci_err "$out")"; fi
}
net_list_all(){
  echo "本区域子网 → 承载实例："
  local subs; subs=$(o network subnet list -c "$TENANCY" --query 'data[].["display-name","cidr-block",id]' 2>/dev/null | jq -r '.[]|@tsv')
  # 预取实例与其子网映射
  declare -A MAP
  local d; d=$(o compute instance list -c "$TENANCY" --all --query 'data[?"lifecycle-state"!=`"TERMINATED"`].[id,"display-name"]' 2>/dev/null | jq -r '.[]|@tsv')
  while IFS=$'\t' read -r id nm; do [ "$INTR" = 1 ] && { INTR=0; break; }; [ -z "$id" ] && continue; local s; s=$(o compute instance list-vnics --instance-id "$id" --query 'data[?"is-primary"]|[0]."subnet-id"' --raw-output 2>/dev/null); MAP[$s]="${MAP[$s]}$nm "; done <<< "$d"
  local -a SUB_IDS=() SUB_NAMES=(); local i=0
  while IFS=$'\t' read -r sname cidr sid; do
    [ -z "$sid" ] && continue; i=$((i+1))
    SUB_IDS[$i]="$sid"; SUB_NAMES[$i]="$sname"
    printf "  %-3s %-22s %-15s [..%s] 承载：%s\n" "$i" "$sname" "$cidr" "${sid: -6}" "${MAP[$sid]:-（无实例）}"
  done <<< "$subs"
  echo
  _ask -rp "删除空子网？输入编号删除，回车跳过: " idx
  [ -z "$idx" ] && return
  local delid="${SUB_IDS[$idx]}" delname="${SUB_NAMES[$idx]}"
  [ -z "$delid" ] && { echo "$(_t "编号无效" "L_INVALID_NUM")"; return; }
  [ -n "${MAP[$delid]}" ] && { echo "该子网仍有实例，不能删除"; return; }
  _ask -rp "确认删除子网 $delname [..${delid: -6}]？(yes/n): " c; [ "$c" != yes ] && return
  o network subnet delete --subnet-id "$delid" --force >/dev/null 2>&1 && echo "$(_t "已删除。" "L_DELETED")" || echo "删除失败（可能仍有其他资源占用，如VNIC/负载均衡/路由表）"
}

# ============ 引导卷 ============
bv_get(){ pick_instance || return 1; BV_ID=$(o compute boot-volume-attachment list -c "$TENANCY" --availability-domain "$SEL_AD" --instance-id "$SEL_ID" --query 'data[0]."boot-volume-id"' --raw-output 2>/dev/null); [ -z "$BV_ID" ] && { echo "未找到引导卷"; return 1; }; return 0; }
bv_list(){
  bv_get || return
  local info; info=$(o bv boot-volume get --boot-volume-id "$BV_ID" 2>/dev/null)
  local nm sz vpu state
  nm=$(echo "$info" | jq -r '.data."display-name" // "-"')
  sz=$(echo "$info" | jq -r '.data."size-in-gbs" // "-"')
  vpu=$(echo "$info" | jq -r '.data."vpus-per-gb" // "-"')
  state=$(echo "$info" | jq -r '.data."lifecycle-state" // "-"')
  local perf="平衡"; [ "$vpu" = 0 ] && perf="较低成本"; [ "$vpu" -ge 20 ] 2>/dev/null && perf="高性能"
  echo "  名称：$nm"
  echo "  大小：${sz}GB"
  echo "  性能：VPU $vpu（$perf）"
  echo "  状态：$state"
  local dvn dvs dvi dlines="" total="$sz"
  while IFS=$'\t' read -r dvn dvs dvi; do
    [ -z "$dvs" ] && continue
    [ -z "$dlines" ] && echo "  ── 挂载的数据盘 ──"
    echo "  数据盘：$dvn  ${dvs}GB"
    dlines="${dlines}数据盘：$dvn ${dvs}GB  
"; total=$(( ${total:-0} + dvs ))
  done < <(_inst_data_vols "$SEL_ID" "$SEL_AD")
  [ -n "$dlines" ] && echo "  合计：${total}GB（引导卷 ${sz}GB + 数据盘）"
  notify "引导卷" "$SEL_NAME" "大小：${sz}GB" "性能：VPU$vpu（$perf）" "状态：$state" ${dlines:+"$dlines合计：${total}GB"}
}
bv_expand(){
  bv_get || return
  local old; old=$(o bv boot-volume get --boot-volume-id "$BV_ID" --query 'data."size-in-gbs"' --raw-output 2>/dev/null)
  local _hr="${HOME_REGION:-$OCI_REGION}"
  if [ "$OCI_REGION" != "$_hr" ]; then
    echo "$(_t "⚠️ 当前是副区域（%s），引导卷扩容全部计费，无免费额度" "L_BV_SUBREGION" "$OCI_REGION")"
  fi
  echo "$SEL_NAME 当前引导卷：${old}GB（只能扩不能缩；免费额度整账号合计200G，仅主区域）"
  local sz; _askc "$(_t "扩容到 GB" "L_EXTEND_TO")" sz || return
  _is_int "$sz" || { echo "必须是整数"; return; }
  [ "$sz" -gt "$old" ] || { echo "必须大于当前 ${old}GB"; return; }
  if [ "$sz" -gt 200 ]; then _ask -rp "$(_t "⚠️ %sGB 超过200G 会收费且无法缩回，确认输 yes: " "L_ASK_OVER200" "${sz}")" c; [ "$c" = yes ] || return; fi
  _confirm "确认 $SEL_NAME 引导卷 ${old}GB → ${sz}GB？（不可逆）" || return
  local out; out=$(o bv boot-volume update --boot-volume-id "$BV_ID" --size-in-gbs "$sz" 2>&1) || { echo "失败：$(_oci_err "$out")"; notify "引导卷扩容失败" "$SEL_NAME" "原因：$(_oci_err "$out")"; return; }
  sleep 5
  local now; now=$(o bv boot-volume get --boot-volume-id "$BV_ID" --query 'data."size-in-gbs"' --raw-output 2>/dev/null)
  if [ "$now" = "$sz" ]; then
    echo "云端已扩至 ${now}GB。还需在节点机 $SEL_NAME 里扩分区（或重启实例自动扩）："
    echo "  echo 1 | sudo tee /sys/class/block/sda/device/rescan"
    echo "  sudo growpart /dev/sda 1"
    echo "  sudo resize2fs /dev/sda1"
    notify "引导卷扩容" "$SEL_NAME" "变更：${old}GB → ${now}GB" "状态：AVAILABLE（云端已扩容）" "提示：需在节点机扩分区或重启实例后生效"
  else
    echo "已提交但云端大小仍为 ${now}GB，稍后在引导卷查看确认。"
    notify "引导卷扩容失败" "$SEL_NAME" "原因：提交后大小仍为 ${now}GB"
  fi
}
bv_perf(){
  bv_get || return
  local old; old=$(o bv boot-volume get --boot-volume-id "$BV_ID" --query 'data."vpus-per-gb"' --raw-output 2>/dev/null)
  echo "$SEL_NAME 当前 VPU：$old   可选：0=较低成本 10=平衡 20=较高性能（10的倍数，最高120）"
  local vpu; _askc "VPU" vpu || return
  _is_int "$vpu" && [ $((vpu % 10)) -eq 0 ] && [ "$vpu" -le 120 ] || { echo "$(_t "必须是 0-120 之间 10 的倍数" "L_VPU_RANGE")"; return; }
  [ "$vpu" = "$old" ] && { echo "$(_t "与当前相同，无需修改。" "L_NO_CHANGE")"; return; }
  [ "$vpu" -gt 10 ] && echo "$(_t "⚠️ VPU 高于10 会产生额外费用。" "L_VPU_COST_WARN")"
  _confirm "确认 VPU $old → $vpu？" || return
  local out; out=$(o bv boot-volume update --boot-volume-id "$BV_ID" --vpus-per-gb "$vpu" 2>&1) || { echo "失败：$(_oci_err "$out")"; notify "引导卷性能失败" "$SEL_NAME" "原因：$(_oci_err "$out")"; return; }
  sleep 5
  local now; now=$(o bv boot-volume get --boot-volume-id "$BV_ID" --query 'data."vpus-per-gb"' --raw-output 2>/dev/null)
  if [ "$now" = "$vpu" ]; then echo "$(_t "已生效：VPU %s" "L_VPU_DONE" "$now")"; notify "引导卷性能" "$SEL_NAME" "变更：VPU$old → VPU$now" "状态：已生效"
  else echo "$(_t "已提交但当前仍为 VPU %s，稍后确认。" "L_VPU_PENDING" "$now")"; notify "引导卷性能失败" "$SEL_NAME" "原因：提交后仍为 VPU$now"; fi
}
bv_shrink(){ echo "缩硬盘：新建 47GB 引导卷替换，原数据不保留，需分离/挂回，风险高。"; echo "当前版本暂不自动执行，建议控制台 Cloud Shell 手动操作。"; }

# ============ 流量/配额/成本 ============
_fmt_bytes(){ awk -v b="$1" 'BEGIN{ if(b>=1073741824) printf "%.2f GB", b/1073741824; else printf "%.2f MB", b/1048576 }'; }
traffic_stat(){
  pick_instance || return
  local vnic; vnic=$(o compute instance list-vnics --instance-id "$SEL_ID" --query 'data[0].id' --raw-output)
  local start end; start=$(date -u +%Y-%m-01T00:00:00Z); end=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  echo; echo "── 流量统计（$SEL_NAME，本月出站）──"
  echo "$(_t "读取中..." "L_LOADING")"
  local rows; rows=$(o monitoring metric-data summarize-metrics-data --namespace oci_vcn --compartment-id "$TENANCY" \
    --query-text "VnicToNetworkBytes[1d]{resourceId = \"$vnic\"}.sum()" --start-time "$start" --end-time "$end" \
    --query 'data[0]."aggregated-datapoints"[].[timestamp,value]' 2>/dev/null | jq -r '.[]|@tsv' 2>/dev/null)
  [ -z "$rows" ] && { echo "$(_t "无数据" "L_NO_DATA")"; return; }
  printf "%-12s %s\n" "日期" "出站"
  local total=0
  while IFS=$'\t' read -r ts val; do
    [ -z "$ts" ] && continue
    printf "%-12s %s\n" "${ts:0:10}" "$(_fmt_bytes "${val%.*}")"
    total=$(( total + ${val%.*} ))
  done <<< "$rows"
  echo "────────────"
  echo "本月总计：$(_fmt_bytes "$total")"
  notify "流量统计" "$SEL_NAME" "本月出站总计：$(_fmt_bytes "$total")"
}
# 查某个计算额度在指定可用域的 已用/可用。输出 "已用<TAB>可用"，失败输出空
_limit_avail(){ o limits resource-availability get --service-name compute --limit-name "$1" --compartment-id "$TENANCY" \
  --availability-domain "$2" 2>/dev/null | jq -r '.data | "\(.used // 0)\t\(.available // "")"' 2>/dev/null; }
quota_query(){
  echo "$(_t "读取可用域与规格..." "L_READING_AD_SHAPE")"
  local ads; ads=$(o iam availability-domain list --query 'data[].name' 2>/dev/null | jq -r '.[]' 2>/dev/null)
  [ -z "$ads" ] && { echo "$(_t "读取可用域失败" "L_AD_FAIL")"; return; }
  local ad u a push=""
  printf "%-24s %-26s %s\n" "可用域" "AMD Micro（免费2台）" "ARM A1（免费4核/24G）"
  while read -r ad; do
    [ -z "$ad" ] && continue
    local shapes c1 c2 uc ac um am
    shapes=$(o compute shape list -c "$TENANCY" --availability-domain "$ad" --all --query 'data[].shape' 2>/dev/null | jq -r '.[]' 2>/dev/null)
    # AMD
    if [ -n "$shapes" ] && ! grep -qx 'VM.Standard.E2.1.Micro' <<< "$shapes"; then c1="❌ 本区域不提供"
    else IFS=$'\t' read -r u a < <(_limit_avail standard-e2-micro-core-count "$ad")
         [ -n "$a" ] && c1="已用${u%.*}台 剩${a%.*}台" || c1="查询失败"; fi
    # ARM
    if [ -n "$shapes" ] && ! grep -qx 'VM.Standard.A1.Flex' <<< "$shapes"; then c2="❌ 本区域不提供"
    else IFS=$'\t' read -r uc ac < <(_limit_avail standard-a1-core-count "$ad")
         IFS=$'\t' read -r um am < <(_limit_avail standard-a1-memory-count "$ad")
         if [ -n "$ac" ]; then
           local fc=$((4-${uc%.*})) fm=$((24-${um%.*})); [ $fc -lt 0 ] && fc=0; [ $fm -lt 0 ] && fm=0
           c2="已用${uc%.*}核/${um%.*}G，免费剩${fc}核/${fm}G（含付费还能开 ${ac%.*}核）"
         else c2="查询失败"; fi; fi
    printf "%-24s %-26s %s\n" "${ad##*:}" "$c1" "$c2"
    push="${push}${ad##*:}  
AMD：$c1  
ARM：$c2  
"
  done <<< "$ads"
  echo "$(_t "（免费额度按整个租户计算；超出免费部分按量收费）" "L_FREE_TIER_NOTE")"
  dingtalk_push "配额查询" "📈 配额查询

账号：${ACC_NAME}

区域：${OCI_REGION}

${push}
时间：$(bj_time)"
}
_cost_query(){  # $1=start $2=end $3=granularity $4=groupby $5=范围描述(用于钉钉)
  local hr="${HOME_REGION:-$OCI_REGION}" gb=""
  [ -n "$4" ] && gb="--group-by [\"$4\"]"
  local out
  out=$(oci --config-file "$OCI_CFG" --region "$hr" usage-api usage-summary request-summarized-usages \
    --tenant-id "$TENANCY" --time-usage-started "$1" --time-usage-ended "$2" \
    --granularity "$3" --query-type COST $gb 2>/dev/null)
  [ -z "$out" ] && { echo "$(_t "无数据" "L_NO_DATA")"; return; }
  # 明细行（键 值 币种），第一列日期或服务名
  local rows
  rows=$(echo "$out" | jq -r '
    [.data.items[] | {
      k:(if .service then .service else (."time-usage-started"[5:10]) end),
      a:((."computed-amount"//0)*100|floor/100),
      c:.currency }]
    | sort_by(.k)
    | .[] | [.k, (.a|tostring), .c] | @tsv' 2>/dev/null)
  # 终端显示
  printf "%-22s %12s %s\n" "项目/日期" "金额" "币种"
  echo "$rows" | awk -F'\t' '{printf "%-22s %12s %s\n",$1,$2,$3; sum+=$2; cur=$3} END{if(NR)printf "%-22s %12s %s\n","合计",(int(sum*100)/100),cur}'
  # 钉钉推送（明细+合计）；每行末尾补两空格实现 markdown 换行
  local detail total
  detail=$(echo "$rows" | awk -F'\t' '{printf "  %s  %s %s  \n",$1,$2,$3; sum+=$2; cur=$3} END{printf "@@%.2f %s",sum,cur}')
  total="${detail##*@@}"; detail="${detail%@@*}"
  local ts; ts=$(bj_time)
  local md="💰 账单查询

账号：${ACC_NAME:-—}

区域：${OCI_REGION:-—}

范围：${5:-—}

**明细：**
${detail}
**合计：${total}**

时间：${ts}"
  dingtalk_push "账单查询" "$md"
}
# 本月账单：按服务 + 按日 合并一条
_cost_month(){
  local hr="${HOME_REGION:-$OCI_REGION}"
  local s e; s=$(date -u +%Y-%m-01T00:00:00Z); e=$(date -u +%Y-%m-%dT00:00:00Z)
  echo "$(_t "读取中..." "L_LOADING")"
  # 按服务
  local svc_out; svc_out=$(oci --config-file "$OCI_CFG" --region "$hr" usage-api usage-summary request-summarized-usages \
    --tenant-id "$TENANCY" --time-usage-started "$s" --time-usage-ended "$e" --granularity MONTHLY --query-type COST --group-by '["service"]' 2>/dev/null)
  # 按日
  local day_out; day_out=$(oci --config-file "$OCI_CFG" --region "$hr" usage-api usage-summary request-summarized-usages \
    --tenant-id "$TENANCY" --time-usage-started "$s" --time-usage-ended "$e" --granularity DAILY --query-type COST 2>/dev/null)
  [ -z "$svc_out" ] && { echo "$(_t "无数据" "L_NO_DATA")"; return; }
  local svc day total cur
  svc=$(echo "$svc_out" | jq -r '[.data.items[]|{k:.service,a:((."computed-amount"//0)*100|floor/100),c:.currency}]|sort_by(.k)|.[]|"  \(.k)  \(.a) \(.c)"' 2>/dev/null)
  day=$(echo "$day_out" | jq -r '[.data.items[]|{k:(."time-usage-started"[5:10]),a:((."computed-amount"//0)*100|floor/100),c:.currency}]|sort_by(.k)|.[]|"  \(.k)  \(.a) \(.c)"' 2>/dev/null)
  # 钉钉 markdown 换行：每行末尾补两个空格
  local svc_md day_md
  svc_md=$(echo "$svc" | sed 's/$/  /')
  day_md=$(echo "$day" | sed 's/$/  /')
  total=$(echo "$svc_out" | jq -r '[.data.items[].["computed-amount"//0]]|add|(.*100|floor)/100' 2>/dev/null)
  cur=$(echo "$svc_out" | jq -r '.data.items[0].currency' 2>/dev/null)
  # 终端显示
  echo; echo "$(_t "按服务：" "L_BY_SERVICE")"; echo "$svc"
  echo "$(_t "按日：" "L_BY_DAY")"; echo "$day"
  echo "合计：$total $cur"
  # 钉钉
  local ts; ts=$(bj_time)
  local md="💰 本月账单

账号：${ACC_NAME:-—}

区域：${OCI_REGION:-—}

**按服务：**
${svc_md}

**按日：**
${day_md}

**合计：${total} ${cur}**

时间：${ts}"
  dingtalk_push "本月账单" "$md"
}
