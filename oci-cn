# 简单校验 CIDR 格式（x.x.x.x/y）
_valid_cidr(){
  local c="$1" ip mask
  case "$c" in */*) ip="${c%/*}"; mask="${c#*/}";; *) return 1;; esac
  case "$mask" in ""|*[!0-9]*) return 1;; esac
  [ "$mask" -gt 32 ] && return 1
  local tmp="$ip" n=0
  while [ -n "$tmp" ]; do
    n=$((n+1))
    case "$tmp" in *.*) tmp="${tmp#*.}";; *) tmp="";; esac
  done
  [ "$n" -eq 4 ] || return 1
  local o1 o2 o3 o4 rest
  o1="${ip%%.*}"; rest="${ip#*.}"
  o2="${rest%%.*}"; rest="${rest#*.}"
  o3="${rest%%.*}"; o4="${rest#*.}"
  local o
  for o in "$o1" "$o2" "$o3" "$o4"; do
    case "$o" in ""|*[!0-9]*) return 1;; esac
    [ "$o" -gt 255 ] && return 1
  done
  return 0
}
