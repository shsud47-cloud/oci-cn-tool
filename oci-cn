  if [ -f "$CF_FILE" ]; then
    local _rt; _rt=$(sed -n '3p' "$CF_FILE"); [ -z "$_rt" ] && _rt="A"
    echo "已配置（域名：${_cfgdomain:-未知}，记录类型：$_rt）。 1 重新设置   2 测试   3 关闭   0 返回"
    _ask -rp "$(_t "选择: " "L_ASK_CHOOSE")" x
    case "$x" in
      2) local t z; t=$(sed -n '1p' "$CF_FILE"); z=$(sed -n '2p' "$CF_FILE")
         echo "$(_t "验证 Token..." "L_VERIFYING_TOKEN")"
         local r; r=$(curl -s -m 15 -H "Authorization: Bearer $t" "https://api.cloudflare.com/client/v4/zones/$z" 2>/dev/null | jq -r '.result.name // .errors[0].message' 2>/dev/null)
         echo "$(_t "结果：%s（显示域名即成功）" "L_VERIFY_RESULT" "$r")"; return;;
      3) rm -f "$CF_FILE"; echo "$(_t "已关闭 CF 自动更新。" "L_CF_DISABLED")"; return;;
      0) return;;
    esac
  fi
  echo "粘贴 API Token（cfat_... 或旧式 Token，输 0 取消）："
  read -r tok; [ -z "$tok" ] || [ "$tok" = "0" ] && { echo "$(_t "取消" "L_CANCEL")"; return; }
  # Zone ID 不再手填：用域名自动解析（Token 需有 Zone 读取权限）；误粘 32 位 Zone ID 也兼容
  if [ -n "$_cfgdomain" ]; then
    echo "$(_t "输入域名（回车沿用 " "L_ASK_CF_DOMAIN_D")${_cfgdomain}，输 0 取消）："
  else
    echo "$(_t "输入域名（如 example.com，输 0 取消）：" "L_ASK_CF_DOMAIN")"
  fi
  local _indomain; read -r _indomain
  [ "$_indomain" = "0" ] && { echo "$(_t "取消" "L_CANCEL")"; return; }
  [ -z "$_indomain" ] && _indomain="$_cfgdomain"
  [ -z "$_indomain" ] && { echo "$(_t "取消" "L_CANCEL")"; return; }
  echo "$(_t "验证中..." "L_VERIFYING")"
  local r zid
  if [[ "$_indomain" =~ ^[0-9a-fA-F]{32}$ ]]; then
    zid="$_indomain"
    r=$(curl -s -m 15 -H "Authorization: Bearer $tok" "https://api.cloudflare.com/client/v4/zones/$zid" 2>/dev/null | jq -r '.result.name // empty' 2>/dev/null)
  else
    local _zr; _zr=$(curl -s -m 15 -H "Authorization: Bearer $tok" "https://api.cloudflare.com/client/v4/zones?name=$_indomain" 2>/dev/null)
    zid=$(echo "$_zr" | jq -r '.result[0].id // empty' 2>/dev/null)
    r=$(echo "$_zr" | jq -r '.result[0].name // empty' 2>/dev/null)
  fi
  # 严格校验：必须返回一个像域名的字符串（有点、有TLD、不含空格和错误关键词）
  if ! [[ "$r" =~ ^[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?\.[a-zA-Z]{2,}$ ]]; then
    echo "$(_t "验证失败：Token 无效、域名不在该账户下，或 Token 缺少 Zone 读取权限，未保存。" "L_CF_VERIFY_FAIL2")"
    return
  fi
  echo "$(_t "域名：%s" "L_DOMAIN_X" "$r")"
  echo "换IP时更新哪些记录类型？[A] / AAAA / A,AAAA（逗号分隔，输 0 取消）"
  local rt; _ask -rp "$(_t "记录类型 [A]: " "L_ASK_RECTYPE")" rt; rt="${rt:-A}"
  [ "$rt" = "0" ] && { echo "$(_t "取消" "L_CANCEL")"; return; }
  # 校验记录类型合法性
  local _valid=1; IFS=',' read -ra _RTS <<< "$rt"
  for _t in "${_RTS[@]}"; do _t=$(echo "$_t" | tr -d ' ' | tr 'a-z' 'A-Z'); case "$_t" in A|AAAA) ;; *) _valid=0;; esac; done
  [ "$_valid" = 0 ] && { echo "记录类型无效（只支持 A / AAAA），未保存。"; return; }
  printf '%s\n%s\n%s\n%s\n' "$tok" "$zid" "$rt" "$r" > "$CF_FILE"; chmod 600 "$CF_FILE"
  echo "已保存（$r，记录类型：$rt）。"
}

# ── 每日账单 ──
do_daily_billing(){
  local yesterday today s e
  yesterday=$(date -u -d '1 day ago' +%Y-%m-%d 2>/dev/null)
  [ -z "$yesterday" ] && yesterday=$(date -u -v-1d +%Y-%m-%d 2>/dev/null)
  today=$(date -u +%Y-%m-%d 2>/dev/null)
  # DAILY 粒度要求整点：昨日零点到今日零点
  s="${yesterday}T00:00:00Z"; e="${today}T00:00:00Z"

  # 租户选择：daily-billing-accounts 存在则只推选中的，否则全部 PAYG
  local sel_file="$HOME_DIR/daily-billing-accounts"
  local -a accounts=()
  if [ -f "$sel_file" ]; then
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      local st8; st8=$(awk 'BEGIN{FS="\t"} $1==n{print $8}' n="$line" "$ACC_FILE" 2>/dev/null)
      [ "$st8" = "INVALID" ] && continue
      accounts+=("$line")
    done < "$sel_file"
  else
    while IFS=$'\t' read -r name _t _u _f _h _tn _pl _st; do
      [ -z "$name" ] && continue
      [ "$_pl" = "PAYG" ] && [ "$_st" != "INVALID" ] && accounts+=("$name")
    done < "$ACC_FILE"
  fi

  local title="💰 每日账单 $yesterday"
  local body=""
  local i=0
  for name in "${accounts[@]}"; do
    i=$((i+1))
    # 从 accounts.tsv 获取 region
    local region=$(grep -P "^${name}\t" "$ACC_FILE" 2>/dev/null | cut -f5)
    [ -z "$region" ] && region=$(grep "^${name}	" "$ACC_FILE" 2>/dev/null | cut -f5)
    local amt="?" cur="JPY"
    if [ -n "$region" ]; then
      local cfg=$(oci_cfg "$name" "$region" 2>/dev/null)
      if [ -n "$cfg" ] && [ -f "$cfg" ]; then
        local tenancy=$(grep "^${name}	" "$ACC_FILE" 2>/dev/null | cut -f2)
        local out=$(oci --config-file "$cfg" --region "$region" usage-api usage-summary request-summarized-usages --tenant-id "$tenancy" --time-usage-started "$s" --time-usage-ended "$e" --granularity DAILY --query-type COST 2>/dev/null)
        if [ -n "$out" ]; then
          echo "$out" | BILL_NAME="$name" BILL_DATE="$yesterday" python3 -c "
import json,sys,os
from datetime import datetime
d=json.load(sys.stdin)
items=d['data']['items']
log='/var/log/oci-billing-raw.log'
try:
    with open(log,'a') as f:
        f.write(datetime.now().isoformat()+' name='+os.environ.get('BILL_NAME','?')+' date='+os.environ.get('BILL_DATE','?')+' items='+str(len(items))+'
')
        for it in items:
            f.write('  amt='+str(it.get('computed-amount'))+' cur='+str(it.get('currency'))+'
')
except: pass
" 2>/dev/null
          local grouped=$(echo "$out" | python3 -c "
import json,sys
from collections import OrderedDict
d=json.load(sys.stdin)
items=d['data']['items']
g=OrderedDict()
for it in items:
    c=it.get('currency') or 'JPY'
    a=it.get('computed-amount') or 0
    g[c]=g.get(c,0)+a
parts=['%.2f %s' % (a,c) for c,a in g.items()]
print(' / '.join(parts) if parts else '0.00 JPY')
" 2>/dev/null)
          if [ -n "$grouped" ]; then amt="$grouped"; cur=""; fi
        fi
      fi
    fi
    body="${body}${i}、${name} ${amt} ${cur}  
"
  done

  local now=$(bj_time)
  local md="💰 每日账单 $yesterday

${body}时间：${now}"
  # 标题、正文分开传（与账单查询推送格式一致），按真实发送结果输出
  if dingtalk_push "$title" "$md" 2>/dev/null; then
    echo "$(_t "已推送" "L_BILL_PUSHED")"
  else
    echo "$(_t "推送失败" "L_BILL_PUSH_FAIL")"
  fi
}

billing_tick(){
  local conf="$HOME_DIR/daily-billing.conf"
  [ -f "$conf" ] || return 0
  local set_time=$(head -1 "$conf" 2>/dev/null | tr -d ' \n\r')
  [ -z "$set_time" ] && return 0
  # 检查开关
  local enabled=$(sed -n '2p' "$conf" 2>/dev/null | tr -d ' \n\r')
  [ "$enabled" = "0" ] && return 0
  # 北京时间当前时间
  local now_bj=$(TZ=$(get_tz) date +%H:%M)
  if [ "$now_bj" = "$set_time" ]; then
    # 防止同一分钟内重复触发（按分钟粒度，允许一天内多次测试）
    local last="$HOME_DIR/.billing_last"
    local now_min=$(TZ=$(get_tz) date +%Y-%m-%d_%H:%M)
    [ -f "$last" ] && [ "$(cat "$last")" = "$now_min" ] && return 0
    echo "$now_min" > "$last"
    verify_usability quiet
    do_daily_billing
  fi
}

select_billing_accounts(){
  local sel_file="$HOME_DIR/daily-billing-accounts"
  echo "选择要推送的租户（FREE_TIER 不显示）："
  local -a payg_names=()
  local idx=0
  while IFS=$'\t' read -r name _t _u _f _h _tn _pl _st; do
    [ -z "$name" ] && continue
    [ "$_pl" = "PAYG" ] || continue
    [ "$_st" = "INVALID" ] && continue
    idx=$((idx+1))
    payg_names+=("$name")
    echo " $idx) $name"
  done < "$ACC_FILE"
  echo " 0) 返回（不改）"
  echo " 直接回车=全部 PAYG"
  _ask -rp "输入编号（空格分隔）: " sel
  [ "$sel" = "0" ] && return
  if [ -z "$sel" ]; then
    rm -f "$sel_file"
    echo "已设为全部 PAYG"
    return
  fi
  > "$sel_file"
  for n in $sel; do
    if [ "$n" -ge 1 ] 2>/dev/null && [ "$n" -le "$idx" ] 2>/dev/null; then
      echo "${payg_names[$((n-1))]}" >> "$sel_file"
    fi
  done
  echo "已保存 $(wc -l < "$sel_file") 个租户"
}

billing_menu(){
  while true; do
    local conf="$HOME_DIR/daily-billing.conf"
    local tm="12:00" en="开启"
    [ -f "$conf" ] && tm=$(head -1 "$conf" | tr -d ' \n\r')
    [ -f "$conf" ] && [ "$(sed -n '2p' "$conf" | tr -d ' \n\r')" = "0" ] && en="关闭"
    echo
    echo "── 每日账单 ──"
    echo "状态: $en | 推送时间: $tm ($(get_tz))"
    echo " 1修改推送时间 2测试推送"
    echo " 3开启/关闭 4选择租户 0返回"
    _ask -rp "选择: " x
    case "$x" in
      1)
        _ask -rp "推送时间 (HH:MM): " nt
        nt=$(echo "$nt" | tr -d ' \t\n\r')
        if [[ "$nt" =~ ^[0-9]{2}:[0-9]{2}$ ]]; then
          local e2=$(sed -n '2p' "$conf" 2>/dev/null)
          echo "$nt" > "$conf"
          [ -n "$e2" ] && echo "$e2" >> "$conf"
          echo "已设为 $nt"
        else
          echo "格式错误"
        fi
        ;;
      2) do_daily_billing;;
      3)
        local cur="1"
        [ -f "$conf" ] && cur=$(sed -n '2p' "$conf" | tr -d ' \n\r')
        [ -z "$cur" ] && cur="1"
        local nt="0"; [ "$cur" = "0" ] && nt="1"
        local t1=$(head -1 "$conf" 2>/dev/null); [ -z "$t1" ] && t1="12:00"
        echo "$t1" > "$conf"; echo "$nt" >> "$conf"
        [ "$nt" = "1" ] && echo "已开启" || echo "已关闭"
        ;;
      4) select_billing_accounts;;
      0) return;;
    esac
    pause
  done
}

set_password(){
  local flag="$HOME_DIR/.nopass"
  echo
  if [ -f "$flag" ]; then
    echo "当前：无密码（明文）"
  else
    echo "当前：已设密码（密文）"
  fi
  echo " 1设置密码 2取消密码(明文)"
  echo " 0返回"
  _ask -rp "选择: " x
  case "$x" in
    1)
      _ask -rsp "输入新密码: " p1; echo
      _ask -rsp "再次输入: " p2; echo
      [ "$p1" = "$p2" ] || { echo "两次不一致"; return; }
      [ -z "$p1" ] && { echo "密码不能为空"; return; }
      # 先用旧密码解密到临时目录（兼容明文和密文两种当前状态）
      local tmpd=$(mktemp -d 2>/dev/null) || { echo "临时目录创建失败"; return; }
      local ok=1 cnt=0
      if [ -f "$flag" ]; then
        # 当前明文：直接复制 .pem
        for f in "$KEYS_DIR"/*.pem; do
          [ -f "$f" ] || continue
          cp "$f" "$tmpd/" 2>/dev/null && cnt=$((cnt+1))
        done
      else
        # 当前密文：用旧 PASS 解密 .pem.enc
        for f in "$KEYS_DIR"/*.pem.enc; do
          [ -f "$f" ] || continue
          local base=$(basename "$f" .pem.enc)
          if dec_key "$f" "$tmpd/$base.pem" 2>/dev/null && [ -s "$tmpd/$base.pem" ]; then
            cnt=$((cnt+1))
          else
            ok=0; break
          fi
        done
      fi
      if [ "$ok" = "0" ] || [ "$cnt" = "0" ]; then
        rm -rf "$tmpd"
        echo "解密现有密钥失败，未改动"; return
      fi
      # 用新密码加密
      PASS="$p1"
      for f in "$tmpd"/*.pem; do
        [ -f "$f" ] || continue
        local base=$(basename "$f" .pem)
        if ! enc_key "$f" "$KEYS_DIR/$base.pem.enc" 2>/dev/null; then ok=0; break; fi
      done
      rm -rf "$tmpd"
      if [ "$ok" = "1" ]; then
        # 更新 verify.enc 为新密码
        printf '%s' "$VERIFY_TOKEN" | OCN_PW="$PASS" openssl enc -aes-256-cbc -pbkdf2 -salt -pass env:OCN_PW -out "$VERIFY_ENC" 2>/dev/null
        echo "0" > "$ATTEMPT_FILE"
        rm -f "$KEYS_DIR"/*.pem "$flag"
        # 同步 cron 密码，否则每日账单推送会因密码失效而中断
        printf '%s' "$p1" > "$HOME_DIR/.cron_pass" 2>/dev/null && chmod 600 "$HOME_DIR/.cron_pass" 2>/dev/null
        echo "已设置新密码，密钥已重新加密（cron 推送密码已同步）"
      else
        echo "加密失败，未改动（旧密码仍有效）"
      fi
      ;;
    2)
      # 需要验证当前密码（如果已设）
      if [ ! -f "$flag" ]; then
        _ask -rsp "输入当前密码: " p0; echo
        [ "$p0" = "$PASS" ] || { echo "密码错误"; return; }
        # 解密全部为明文
        for f in "$KEYS_DIR"/*.pem.enc; do
          [ -f "$f" ] || continue
          local base=$(basename "$f" .pem.enc)
          dec_key "$f" "$KEYS_DIR/$base.pem" 2>/dev/null
        done
        rm -f "$KEYS_DIR"/*.pem.enc "$VERIFY_ENC"
      fi
      touch "$flag"
      PASS=""
      rm -f "$HOME_DIR/.cron_pass"
      echo "0" > "$ATTEMPT_FILE"
      echo "已取消密码，密钥为明文"
      ;;
    0) return;;
  esac
}
