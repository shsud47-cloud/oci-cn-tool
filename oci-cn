L=$lbl; M=/mnt/$lbl; B=$bytes
if findmnt -rn -S LABEL=\$L >/dev/null; then echo "✅ 已在使用：\$(findmnt -rno TARGET -S LABEL=\$L)"; exit 0; fi
D=\$(blkid -L \$L 2>/dev/null)
if [ -z "\$D" ]; then
  C=\$(for d in \$(lsblk -dpnbo NAME,SIZE,TYPE | awk -v b=\$B '\$3=="disk" && \$2==b{print \$1}'); do
       [ -z "\$(lsblk -no FSTYPE,MOUNTPOINT \$d | tr -d ' \n')" ] && [ "\$(lsblk -no NAME \$d | wc -l)" = 1 ] && echo \$d; done)
  N=\$(echo "\$C" | grep -c .)
