XEOF
EOF
    line
    echo "$(_t "数据目录：/mnt/%s" "L_DATA_DIR" "$lbl")"
    _push_acct "🔗" "挂载块存储卷" "区域：$r" "卷：$vnm（${vsz}G）" "实例：$inm" "状态：ATTACHED（云端已挂载）" "目录：/mnt/$lbl（需在节点机执行挂载命令后可用）"
