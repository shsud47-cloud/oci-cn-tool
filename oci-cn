#!/usr/bin/env bash
# oci-cn —— 中文菜单 OCI 管理工具（基于官方 oci-cli），替代 oci-helper
# 运行在面板机。密钥加密存放，运行时解密到 /dev/shm，退出即焚。
# 一个账号一份配置，区域实时从 API 读取，主区域自动标注。
set -o pipefail
umask 077

VERSION="6.10.2"

# 全局关闭 oci 的文件权限警告，否则它会混进 stdout 冲垮 jq
export OCI_CLI_SUPPRESS_FILE_PERMISSIONS_WARNING=True
export SUPPRESS_LABEL_WARNING=True   # 私钥无 OCI_API_KEY 标签时不再输出警告（会混入结果）

# ============ 路径 ============
HOME_DIR="${OCI_CN_HOME:-$HOME/.oci-cn}"
KEYS_DIR="$HOME_DIR/keys"
# ============ 语言 ============
# 从配置文件读取语言设置，默认中文。英文包在同目录 lang/en.sh
OCI_CN_LANG="zh"
[ -f "$HOME_DIR/lang" ] && OCI_CN_LANG=$(head -1 "$HOME_DIR/lang" | tr -d ' \r\n')
[ "$OCI_CN_LANG" = "en" ] && {
  _langfile="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/lang/en.sh"
  [ -f "$_langfile" ] && source "$_langfile"
}
# _t: 翻译函数，用法 _t "中文原文" "L_VARIABLE_NAME"
# 如果英文包已加载且变量存在，返回英文；否则返回中文原文
_t(){
  local _fmt="$1" _var="$2"; shift 2
  if [ "$OCI_CN_LANG" = "en" ] && [ -n "${_var}" ]; then
    local _val; eval "_val=\"\${$_var}\"" 2>/dev/null
    [ -n "$_val" ] && _fmt="$_val"
  fi
  if [ $# -gt 0 ]; then
    # shellcheck disable=SC2059
    printf "$_fmt" "$@"
  else
    printf '%s' "$_fmt"
  fi
}
ACC_FILE="$HOME_DIR/accounts.tsv"
EMAIL_DIR="$HOME_DIR/emails"
DINGTALK_FILE="$HOME_DIR/dingtalk"
CF_FILE="$HOME_DIR/cloudflare"
VERIFY_ENC="$HOME_DIR/verify.enc"
ATTEMPT_FILE="$HOME_DIR/.attempts"
MAX_ATTEMPTS=5
# 时区配置：优先读用户配置，默认 Asia/Shanghai（北京时间）
# 配置文件：$HOME_DIR/timezone（一行一个 IANA 时区名，如 Asia/Shanghai）
# 兼容：也从 $HOME_DIR/daily-billing.conf 里找 TIMEZONE=xxx 或 IANA 时区行
get_tz(){
  local tzf="$HOME_DIR/timezone" tz=""
  [ -f "$tzf" ] && tz=$(head -1 "$tzf" 2>/dev/null | tr -d ' \r\n')
  if [ -z "$tz" ] && [ -f "$HOME_DIR/daily-billing.conf" ]; then
    tz=$(grep -iE '^TIMEZONE=' "$HOME_DIR/daily-billing.conf" 2>/dev/null | head -1 | cut -d= -f2 | tr -d ' \r\n"'"'")
    [ -z "$tz" ] && tz=$(grep -E '^[A-Za-z_]+/[A-Za-z_+-]+' "$HOME_DIR/daily-billing.conf" 2>/dev/null | head -1 | tr -d ' \r\n')
  fi
  if [ -n "$tz" ] && [ -f "/usr/share/zoneinfo/$tz" ]; then
    printf '%s' "$tz"
  else
    printf 'Asia/Shanghai'
  fi
}
# 推送时间戳：用用户配置的时区（默认北京时间 UTC+8）
bj_time(){ TZ=$(get_tz) date '+%Y-%m-%d %H:%M:%S'; }
VERIFY_TOKEN="oci-cn-ok"
RUN_DIR=""
PASS=""

mkdir -p "$KEYS_DIR" "$EMAIL_DIR"
command -v oci >/dev/null || { echo "$(_t "未安装 oci-cli，先执行：" "L_NO_OCLICLI")"; echo '  bash -c "$(curl -L https://raw.githubusercontent.com/oracle/oci-cli/master/scripts/install/install.sh)"'; exit 1; }
command -v openssl >/dev/null || { echo "$(_t "缺少 openssl" "L_NO_OPENSSL")"; exit 1; }
command -v jq >/dev/null || { echo "$(_t "缺少 jq，请先：apt install -y jq" "L_NO_JQ")"; exit 1; }
command -v curl >/dev/null || { echo "$(_t "缺少 curl，请先：apt install -y curl" "L_NO_CURL")"; exit 1; }

# ============ 单实例锁：仅交互模式持有 ============
# CLI 非交互参数（--daily-billing-tick 等）不加锁，避免 cron 被交互会话阻塞
LOCK="$HOME_DIR/.lock"
mkdir -p "$HOME_DIR"
case "$1" in
  --*) ;;
  *)
    exec 9>"$LOCK"
    if ! flock -n 9; then
      echo "$(_t "已有一个 oci-cn 正在运行，不能重复打开。" "L_ALREADY_RUNNING")"
      echo "$(_t "若确认没有在用，执行清理：sudo pkill -f oci-cn 后重试。" "L_CLEANUP_HINT")"
      exit 1
    fi
    ;;
esac
# 清理上次异常退出残留的解密目录
find /dev/shm -maxdepth 1 -name 'oci-cn.*' -type d -mmin +1 -exec rm -rf {} + 2>/dev/null

INTR=0
cleanup(){ [ "$BASHPID" = "$$" ] || return 0; [ -n "$RUN_DIR" ] && rm -rf "$RUN_DIR" 2>/dev/null; PASS=""; flock -u 9 2>/dev/null; }
on_int(){ INTR=1; echo; echo "（已中断，返回菜单…）"; }
trap cleanup EXIT TERM
trap on_int INT

# 提问前清空读取期间误按的按键，只认提示出现后的输入
_flush_input(){ INTR=0; local _x; while read -r -t 0.05 -n 4096 _x 2>/dev/null; do :; done; }
_ask(){ _flush_input; read "$@"; }
# 带取消的输入：_askc "提示" 变量名 [默认值]，输 0 取消并返回1
_askc(){
  _flush_input
  local _prompt="$1" _var="$2" _def="$3" _input
  if [ -n "$_def" ]; then read -rp "${_prompt}（默认${_def}，回车用默认，输 0 取消）: " _input; _input="${_input:-$_def}"
  else read -rp "${_prompt}（输 0 取消）: " _input; fi
  if [ "$_input" = "0" ]; then echo "$(_t "已取消" "L_CANCELLED")"; return 1; fi
  printf -v "$_var" '%s' "$_input"
  return 0
}
pause(){ _ask -rp "回车继续..." _; }
line(){ printf '%.0s─' {1..56}; echo; }

# ============ 钉钉推送 ============
# URL编码（用于加签sign）
_urlencode(){ local s="$1" o="" c i; for ((i=0;i<${#s};i++)); do c="${s:$i:1}"; case "$c" in [a-zA-Z0-9.~_-]) o+="$c";; *) o+=$(printf '%%%02X' "'$c");; esac; done; echo "$o"; }
# 推送 markdown 到钉钉。$1=标题 $2=正文(markdown)
dingtalk_push(){
  [ -f "$DINGTALK_FILE" ] || return 0   # 未配置则静默跳过
  local webhook secret
  webhook=$(sed -n '1p' "$DINGTALK_FILE")
  secret=$(sed -n '2p' "$DINGTALK_FILE")
  [ -z "$webhook" ] && return 0
  local url="$webhook"
  if [ -n "$secret" ]; then
    local ts sign
    ts=$(date +%s%3N)
    sign=$(printf '%s\n%s' "$ts" "$secret" | openssl dgst -sha256 -hmac "$secret" -binary | base64)
    url="${webhook}&timestamp=${ts}&sign=$(_urlencode "$sign")"
  fi
  local body; body=$(jq -nc --arg t "$1" --arg c "$2" '{msgtype:"markdown",markdown:{title:$t,text:$c}}')
  # 返回钉钉 API 真实结果（errcode=0 才算成功），调用方可据此判断
  local resp; resp=$(curl -s -m 10 -X POST -H 'Content-Type: application/json' -d "$body" "$url" 2>/dev/null)
  [ -n "$resp" ] && echo "$resp" | grep -q '"errcode":0'
}
# 换IP后：把指定域名下指向旧IP的 DNS 记录改成新IP。$1=旧IP $2=新IP
# 记录类型从配置文件读取（默认 A，可配 AAAA 或 A,AAAA）
cf_update_ip(){
  [ -f "$CF_FILE" ] || return 0   # 未配置则跳过
  local token zone; token=$(sed -n '1p' "$CF_FILE"); zone=$(sed -n '2p' "$CF_FILE")
  local rectypes; rectypes=$(sed -n '3p' "$CF_FILE"); [ -z "$rectypes" ] && rectypes="A"
  [ -z "$token" ] || [ -z "$zone" ] && return 0
  local oldip="$1" newip="$2"
  [ -z "$oldip" ] || [ "$oldip" = null ] && return 0
  local api="https://api.cloudflare.com/client/v4/zones/$zone/dns_records"
  local updated="" failed="" nok=0 nfail=0
  # 按配置的记录类型逐个处理（逗号分隔，如 A,AAAA）
  local _rt; IFS=',' read -ra _RTS <<< "$rectypes"
  for _rt in "${_RTS[@]}"; do
    _rt=$(echo "$_rt" | tr -d ' ' | tr 'a-z' 'A-Z')
    [ -z "$_rt" ] && continue
    # 查所有指向旧IP的该类型记录
    local recs; recs=$(curl -s -m 15 -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
      "$api?type=$_rt&content=$oldip&per_page=100" 2>/dev/null | jq -r '.result[]?|[.id,.name]|@tsv' 2>/dev/null)
    [ -z "$recs" ] && { echo "$(_t "  CF：没有指向 %s 的 %s 记录" "L_CF_NO_RECS" "$oldip" "$_rt")"; continue; }
    while IFS=$'\t' read -r rid rname; do
      [ -z "$rid" ] && continue
      local ok; ok=$(curl -s -m 15 -X PATCH -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
        --data "{\"content\":\"$newip\"}" "$api/$rid" 2>/dev/null | jq -r '.success' 2>/dev/null)
      if [ "$ok" = true ]; then echo "  CF：[$_rt] $rname → $newip"; updated="${updated}${rname} "; nok=$((nok+1))
      else echo "$(_t "  CF：[%s] %s 更新失败" "L_CF_UPDATE_FAIL" "$_rt" "$rname")"; failed="${failed}${rname} "; nfail=$((nfail+1)); fi
    done <<< "$recs"
  done
  [ -n "$updated" ] && notify "CF-DNS更新" "$SEL_NAME" "旧IP：$oldip" "新IP：$newip" "域名：$updated" "状态：已更新 ${nok} 条"
  [ -n "$failed" ] && notify "CF-DNS更新失败" "$SEL_NAME" "新IP：$newip" "失败域名：$failed" "状态：${nfail} 条未更新，需手动修改"
}
# 操作 -> 图标
_op_icon(){
  case "$1" in
    换IP) echo "🎉";; 开机) echo "▶️";; 关机) echo "⏸️";; 强制关机) echo "⏹️";;
    重启) echo "🔄";; 改配置) echo "⚙️";; 创建) echo "🆕";; 删除) echo "🗑️";;
    改名) echo "✏️";; 附IPv6) echo "🌐";; 开放端口) echo "🔓";; 关闭端口) echo "🔒";;
    放行全部) echo "⚠️";; 测试) echo "🔔";;
    引导卷) echo "💽";; 引导卷扩容) echo "💾";; 引导卷性能) echo "⚡";;
    流量统计) echo "📊";; 配额查询) echo "📈";; 端口规则|查看端口规则) echo "📋";;
    串行控制台) echo "🖥️";; 订阅新区域) echo "🌏";; CF-DNS更新) echo "🌍";;
    账单查询|本月账单) echo "💰";;
    *) echo "📢";;
  esac
}
# 组装并推送。$1=操作(用于选图标和标题) $2=实例名 $3...=额外"字段:值"行（可选）
notify(){
  [ "$INTR" = 1 ] && { INTR=0; _flush_input; echo "已中断，未推送"; return 0; }
  local op="$1" inst="$2"; shift 2
  local fail=0; [[ "$op" == *失败* ]] && fail=1
  local base="${op%失败}"; base="${base%成功}"
  local icon; if [ "$fail" = 1 ]; then icon="❌"; else icon=$(_op_icon "$base"); fi
  local ts; ts=$(bj_time)
  # 仿 Y探长：无 markdown 标题，emoji+操作名一行；字段之间空行（markdown 空行才换行）
  local md="${icon} ${op}

账号：${ACC_NAME:-—}

区域：${OCI_REGION:-—}

实例：${inst:-—}"
  local line
  for line in "$@"; do md="${md}

${line}"; done
  md="${md}

时间：${ts}"
  dingtalk_push "$op" "$md"
}

