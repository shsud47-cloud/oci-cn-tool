}
# 订阅新区域（不可逆）。必须在主区域调用
subscribe_region(){
  local hr="${HOME_REGION:-$OCI_REGION}"
  echo "$(_t "读取区域列表..." "L_READING_REGIONS")"
  # 全部区域
  local all; all=$(o --region "$hr" iam region list --query 'data[].name' --raw-output 2>/dev/null | jq -r '.[]?' 2>/dev/null)
  [ -z "$all" ] && all=$(o --region "$hr" iam region list 2>/dev/null | jq -r '.data[].name' 2>/dev/null)
  [ -z "$all" ] && { echo "读取区域失败"; return; }
  # 已订阅
  local subbed; subbed=$(o --region "$hr" iam region-subscription list --tenancy-id "$TENANCY" 2>/dev/null | jq -r '.data[]."region-name"' 2>/dev/null)
  echo "── 可订阅区域（★=已订阅）──"
  local i=0; local -a keys
  while read -r r; do
    [ -z "$r" ] && continue
    i=$((i+1)); keys[$i]="$r"
    local mark="  "; echo "$subbed" | grep -qx "$r" && mark="★ "
    printf " %2d %s%-22s %s\n" "$i" "$mark" "$r" "$(region_cn "$r")"
  done <<< "$all"
  echo
  echo "⚠️ 订阅不可逆：开通后永久保留，无法取消订阅。"
  _ask -rp "$(_t "输入要订阅的区域编号（0取消）: " "L_ASK_SUB_REGION")" n
  [ "$n" = 0 ] || [ -z "$n" ] && { echo "$(_t "取消" "L_CANCEL")"; return; }
  local target="${keys[$n]}"
  [ -z "$target" ] && { echo "$(_t "编号无效" "L_INVALID_NUM")"; return; }
  if echo "$subbed" | grep -qx "$target"; then echo "该区域已订阅，无需重复。"; return; fi
  echo "将订阅：$target $(region_cn "$target")"
  _ask -rp "确认订阅？不可逆！(输 yes 确认): " c
  [ "$c" = yes ] || { echo "$(_t "取消" "L_CANCEL")"; return; }
  # region-key：取该区域的 key
  local rkey; rkey=$(o --region "$hr" iam region list --query "data[?name=='$target'].key | [0]" --raw-output 2>/dev/null)
  [ -z "$rkey" ] || [ "$rkey" = null ] && { echo "取不到区域key"; return; }
  local out; out=$(o --region "$hr" iam region-subscription create --region-key "$rkey" --tenancy-id "$TENANCY" 2>&1)
  if echo "$out" | grep -q '"region-name"'; then
    echo "订阅成功：$target $(region_cn "$target")"
    local ts; ts=$(bj_time)
    dingtalk_push "订阅新区域" "📢 订阅新区域

账号：${ACC_NAME}

当前区域：${OCI_REGION}

订阅区域：$target $(region_cn "$target")

状态：$(echo "$out" | jq -r '.data.status // "已提交"' 2>/dev/null)

时间：${ts}"
  else
    echo "订阅失败："; echo "$out" | tail -3
    local ts; ts=$(bj_time)
    dingtalk_push "订阅区域失败" "❌ 订阅区域失败

账号：${ACC_NAME}

当前区域：${OCI_REGION}

订阅区域：$target $(region_cn "$target")

时间：${ts}"
  fi
}
