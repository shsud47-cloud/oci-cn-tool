disk_create(){
  local hr="${HOME_REGION:-$OCI_REGION}" r="$OCI_REGION"
  local ads; ads=$(o iam availability-domain list --query 'data[].name' 2>/dev/null | jq -r '.[]' 2>/dev/null)
  local ad; ad=$(head -1 <<< "$ads")
  if [ "$(grep -c . <<< "$ads")" -gt 1 ]; then local k=0 x; local -a A=(); while read -r x; do k=$((k+1)); A[$k]="$x"; echo "  $k  $x"; done <<< "$ads"; _ask -rp "可用域编号[1]: " x; ad="${A[${x:-1}]}"; fi
  [ -z "$ad" ] && { echo "$(_t "读取可用域失败" "L_AD_FAIL")"; return; }
  local nm sz vp; _ask -rp "$(_t "名称（按用途起，如 data/backup/media/fee-volume；字母数字和-，最长16）[data]（输 0 返回）: " "L_ASK_VOL_NAME")" nm; [ "$nm" = "0" ] && { echo "$(_t "已取消" "L_CANCELLED")"; return; }; nm="${nm:-data}"
  [[ "$nm" =~ ^[A-Za-z0-9-]{1,16}$ ]] || { echo "$(_t "名称只能用字母、数字和 -，最长16位" "L_NAME_RULE")"; return; }
