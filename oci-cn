    echo " 1 本月账单（服务+按日）   2 自定义区间"
    echo " 3 设置预算告警   4 设置本账号邮箱   0 返回"
    _ask -rp "$(_t "选择: " "L_ASK_CHOOSE")" c
    local s e
    case "$c" in
      1) _cost_month; pause;;
      2) _ask -rp "起始日期(YYYY-MM-DD): " sd; _ask -rp "结束日期(YYYY-MM-DD): " ed
         _ask -rp "粒度 1=按天 2=按月: " g
         local gran=DAILY gb=""; [ "$g" = 2 ] && { gran=MONTHLY; gb=service; }
         _cost_query "${sd}T00:00:00Z" "${ed}T00:00:00Z" "$gran" "$gb" "自定义 ${sd}~${ed}"; pause;;
      3) budget_alert; pause;;
