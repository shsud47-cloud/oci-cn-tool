# ============ 非交互 CLI 模式（v6.5） ============
# 用法: oci-cn --list-rules --instance <实例名或公网IP> [--account <账号名>] [--region <区域>] [--password <密码>]
# 直接输出该实例生效的安全列表规则并推送钉钉，不进交互菜单。
# 密码也可通过环境变量 OCI_CN_PASS 提供。
cli_usage(){
  echo "$(_t "用法：" "L_USAGE")"
  echo "  $0 --list-rules --instance <实例名或公网IP> [--account <账号名>] [--region <区域>] [--password <密码>]"
  echo "  $(_t "  $0 --open-port <端口> --protocol <tcp|udp|icmp|all> --instance <实例名或公网IP> [--account <账号名>] [--region <区域>] [--password <密码>] [--yes]" "L_CLI_USAGE_OPEN")"
  echo "  $(_t "  $0 --close-port <编号...> --instance <实例名或公网IP> [--account <账号名>] [--region <区域>] [--password <密码>] [--yes]" "L_CLI_USAGE_CLOSE")"
  echo "  $(_t "  $0 --replace-all --ports \"22/tcp,6700/tcp,6900/tcp,65530/tcp,6600/udp,6801/udp\" --instance <实例名或公网IP> [--account <账号名>] [--region <区域>] [--password <密码>] [--yes]" "L_CLI_USAGE_REPLACE")"
  echo "  $(_t "密码也可用环境变量 OCI_CN_PASS 提供；不加 --yes 时仅预览 diff，不执行变更" "L_USAGE_PASS")"
}
# 在指定账号/区域中按实例名或公网IP匹配实例 -> 输出 "id\tname"，设置 SEL_ID/SEL_NAME
_cli_match_instance(){  # $1=cfg $2=region $3=tenancy $4=keyword
  local cfg="$1" r="$2" tenancy="$3" kw="$4"
  local iid iname ip
  while IFS=$'\t' read -r iid iname; do
    [ -z "$iid" ] && continue
    if [ "$iname" = "$kw" ]; then printf '%s\t%s\n' "$iid" "$iname"; return 0; fi
    ip=$(oci --config-file "$cfg" --region "$r" compute instance list-vnics --instance-id "$iid" --query 'data[?"is-primary"]|[0]."public-ip"' --raw-output 2>/dev/null)
    if [ "$ip" = "$kw" ]; then printf '%s\t%s\n' "$iid" "$iname"; return 0; fi
  done < <(oci --config-file "$cfg" --region "$r" compute instance list -c "$tenancy" --all \
    --query 'data[?"lifecycle-state"!=`"TERMINATED"`].[id,"display-name"]' 2>/dev/null | jq -r '.[]|@tsv' 2>/dev/null)
  return 1
}
# 在账号的各区域中查找实例，命中则设置 ACC_NAME/TENANCY/OCI_REGION/OCI_CFG/SEL_ID/SEL_NAME/SEL_AD
_cli_find_instance(){  # $1=账号名 $2=tenancy $3=主区域 $4=指定区域(可空) $5=关键字
  local name="$1" tenancy="$2" home="$3" want="$4" kw="$5"
  local regions
  if [ -n "$want" ]; then regions="$want"
  else
    regions=$(oci --config-file "$(oci_cfg "$name" "$home")" --region "$home" iam region-subscription list \
      --tenancy-id "$tenancy" 2>/dev/null | jq -r '.data[]."region-name"' 2>/dev/null)
    [ -z "$regions" ] && regions="$home"
  fi
  local r cfg hit
  for r in $regions; do
    cfg=$(oci_cfg "$name" "$r")
    hit=$(_cli_match_instance "$cfg" "$r" "$tenancy" "$kw" 2>/dev/null) || continue
    SEL_ID=$(echo "$hit" | cut -f1); SEL_NAME=$(echo "$hit" | cut -f2)
    ACC_NAME="$name"; TENANCY="$tenancy"; OCI_REGION="$r"; OCI_CFG="$cfg"
    SEL_AD=$(oci --config-file "$cfg" --region "$r" compute instance get --instance-id "$SEL_ID" \
      --query 'data."availability-domain"' --raw-output 2>/dev/null)
    return 0
  done
  return 1
}
# ---------- CLI 共享：鉴权 + 定位实例 + 取默认安全列表 + 拼规则 ----------
_cli_auth(){  # $1=pw
  local pw="$1"
  [ -f "$VERIFY_ENC" ] || { echo "$(_t "还未初始化，请先交互运行一次 oci-cn 设置密码。" "L_CLI_NOT_INIT")"; exit 1; }
  [ -s "$ACC_FILE" ] || { echo "$(_t "无账号配置" "L_CLI_NO_ACCT")"; exit 1; }
  if [ -n "$pw" ]; then PASS="$pw"
  elif [ -t 0 ]; then _ask -rsp "$(_t "解密密码: " "L_ASK_PASSWD")" PASS; echo
  else echo "$(_t "非交互模式需要密码：用 --password 或 OCI_CN_PASS 环境变量提供" "L_NEED_PASS")"; exit 1; fi
  unlock
  prepare_runtime
}
# 跨账号/区域定位实例，命中设置 ACC_NAME/TENANCY/OCI_REGION/OCI_CFG/SEL_ID/SEL_NAME/SEL_AD
_cli_locate_instance(){  # $1=关键字 $2=账号名(可空) $3=区域(可空)
  local kw="$1" acc="$2" region="$3"
  echo "$(_t "查找实例: %s ..." "L_CLI_SEARCHING" "$kw")"
  local found=0
  while IFS=$'\t' read -r name tenancy _u _f home _tn _pl _st; do
    [ -z "$name" ] && continue
    [ -n "$acc" ] && [ "$name" != "$acc" ] && continue
    [ "$home" = - ] && home=""
    if _cli_find_instance "$name" "$tenancy" "$home" "$region" "$kw"; then found=1; break; fi
  done < "$ACC_FILE"
  [ "$found" = 0 ] && { echo "$(_t "未找到实例: %s" "L_CLI_NOT_FOUND" "$kw")"; return 1; }
  echo "$(_t "账号：%s  区域：%s  实例：%s" "L_CLI_FOUND" "$ACC_NAME" "$OCI_REGION" "$SEL_NAME")"
  OCI_CFG=$(oci_cfg "$ACC_NAME" "$OCI_REGION")
  return 0
}
# 取实例所在子网的第一个安全列表 -> SEL_SLID/SEL_SLNAME
_cli_first_seclist(){
  local sid; sid=$(o compute instance list-vnics --instance-id "$SEL_ID" --query 'data[?"is-primary"]|[0]."subnet-id"' --raw-output 2>/dev/null)
  local ids; ids=$(o network subnet get --subnet-id "$sid" --query 'data."security-list-ids"' 2>/dev/null | jq -r '.[]')
  SEL_SLID=$(echo "$ids" | head -1)
  [ -z "$SEL_SLID" ] && { echo "$(_t "子网未绑定安全列表" "L_CLI_NO_SECLIST")"; return 1; }
  SEL_SLNAME=$(o network security-list get --security-list-id "$SEL_SLID" --query 'data."display-name"' --raw-output 2>/dev/null)
  return 0
}
# 拼一条入站规则 JSON：$1=proto(tcp|udp|icmp|all) $2=端口(443 或 8000-8100；icmp/all 忽略)
_cli_rule_json(){
  local proto="$1" spec="$2" pmin pmax
  case "$proto" in
    tcp|udp)
      if [[ "$spec" == *-* ]]; then pmin="${spec%-*}"; pmax="${spec#*-}"; else pmin="$spec"; pmax="$spec"; fi
      _is_int "$pmin" && _is_int "$pmax" && [ "$pmin" -ge 1 ] && [ "$pmax" -le 65535 ] && [ "$pmin" -le "$pmax" ] || return 1
      if [ "$proto" = udp ]; then
        printf '{"protocol":"17","source":"0.0.0.0/0","isStateless":false,"udpOptions":{"destinationPortRange":{"min":%s,"max":%s}}}' "$pmin" "$pmax"
      else
        printf '{"protocol":"6","source":"0.0.0.0/0","isStateless":false,"tcpOptions":{"destinationPortRange":{"min":%s,"max":%s}}}' "$pmin" "$pmax"
      fi;;
    icmp) printf '{"protocol":"1","source":"0.0.0.0/0","isStateless":false}';;
    all)  printf '{"protocol":"all","source":"0.0.0.0/0","isStateless":false}';;
    *) return 1;;
  esac
}
# CLI：开放端口
cli_open_port(){
  local inst="" acc="" region="" pw="${OCI_CN_PASS:-}" proto="" port="" yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --instance) inst="$2"; shift 2;; --account) acc="$2"; shift 2;;
      --region) region="$2"; shift 2;; --password) echo "$(_t "警告：--password 会暴露在进程列表，请改用 OCI_CN_PASS 环境变量" "L_PW_WARN")"; pw="$2"; shift 2;;
      --protocol) proto="$(printf '%s' "$2" | tr 'A-Z' 'a-z')"; shift 2;;
      --open-port) port="$2"; shift 2;; --yes) yes=1; shift;;
      -h|--help) cli_usage; exit 0;;
      *) echo "$(_t "未知参数: $1" "L_UNKNOWN_ARG")"; cli_usage; exit 1;;
    esac
  done
  [ -z "$inst" ] && { echo "$(_t "缺少 --instance 参数" "L_MISSING_INST")"; cli_usage; exit 1; }
  [ -z "$proto" ] && { echo "$(_t "--open-port 需要 --protocol tcp/udp/icmp/all" "L_CLI_OPEN_NEED")"; cli_usage; exit 1; }
  local newrule; newrule=$(_cli_rule_json "$proto" "$port") || { echo "$(_t "端口无效: %s（用 443 或 8000-8100）" "L_CLI_INVALID_PORT" "$port")"; exit 1; }
  _cli_auth "$pw"
  _cli_locate_instance "$inst" "$acc" "$region" || exit 1
  _cli_first_seclist || exit 1
  local cur merged n
  cur=$(o network security-list get --security-list-id "$SEL_SLID" --query 'data."ingress-security-rules"' 2>/dev/null)
  merged=$(echo "$cur" | jq -c ". + [$newrule]")
  n=$(echo "$merged" | jq 'length' 2>/dev/null || echo "?")
  echo "$(_t "安全列表：%s" "L_CLI_SECLIST" "$SEL_SLNAME")"
  echo "$(_t "当前入站规则：" "L_CUR_RULES")"; echo "$cur" | _fmt_rules
  echo "$(_t "将开放 %s %s（来源0.0.0.0/0），执行后将变为（共 %s 条）：" "L_CLI_AFTER_OPEN" "$proto" "$port" "$n")"
  echo "$merged" | _fmt_rules
  if [ "$yes" != 1 ]; then echo "$(_t "未加 --yes，仅预览，未执行任何变更。" "L_CLI_DRYRUN")"; exit 0; fi
  local out; out=$(o network security-list update --security-list-id "$SEL_SLID" --ingress-security-rules "$merged" --force 2>&1)
  if [ $? -eq 0 ]; then
    echo "$(_t "已开放 %s %s" "L_CLI_OPEN_DONE" "$proto" "$port")"
    notify "开放端口成功" "$SEL_NAME" "端口：$proto $port" "状态：已生效，当前入站规则 $(_sl_count "$SEL_SLID") 条"
  else
    echo "$(_t "失败：" "L_FAILED")$(_oci_err "$out")"
    notify "开放端口失败" "$SEL_NAME" "端口：$proto $port" "原因：$(_oci_err "$out")"; exit 1
  fi
}
# CLI：关闭端口（按规则编号）
cli_close_port(){
  local inst="" acc="" region="" pw="${OCI_CN_PASS:-}" nums="" yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --instance) inst="$2"; shift 2;; --account) acc="$2"; shift 2;;
      --region) region="$2"; shift 2;; --password) echo "$(_t "警告：--password 会暴露在进程列表，请改用 OCI_CN_PASS 环境变量" "L_PW_WARN")"; pw="$2"; shift 2;;
      --close-port) nums="$2"; shift 2;; --yes) yes=1; shift;;
      -h|--help) cli_usage; exit 0;;
      *) echo "$(_t "未知参数: $1" "L_UNKNOWN_ARG")"; cli_usage; exit 1;;
    esac
  done
  [ -z "$inst" ] && { echo "$(_t "缺少 --instance 参数" "L_MISSING_INST")"; cli_usage; exit 1; }
  [ -z "$nums" ] && { echo "$(_t "--close-port 需要规则编号，如 --close-port 0" "L_CLI_CLOSE_NEED")"; cli_usage; exit 1; }
  _cli_auth "$pw"
  _cli_locate_instance "$inst" "$acc" "$region" || exit 1
  _cli_first_seclist || exit 1
  local cur; cur=$(o network security-list get --security-list-id "$SEL_SLID" --query 'data."ingress-security-rules"' 2>/dev/null)
  local total; total=$(echo "$cur" | jq 'length' 2>/dev/null || echo 0)
  for n in $nums; do
    _is_int "$n" && [ "$n" -lt "$total" ] || { echo "$(_t "规则编号无效: %s" "L_CLI_INVALID_NUM" "$n")"; exit 1; }
  done
  echo "$(_t "安全列表：%s" "L_CLI_SECLIST" "$SEL_SLNAME")"
  _show_rules "$SEL_SLID"
  local delexpr="["; for n in $nums; do delexpr+="$n,"; done; delexpr="${delexpr%,}]"
  local merged; merged=$(echo "$cur" | jq -c "del(.[$delexpr[]])" 2>/dev/null)
  [ -z "$merged" ] && { echo "$(_t "规则编号无效" "L_CLI_INVALID_NUM")"; exit 1; }
  local n; n=$(echo "$merged" | jq 'length' 2>/dev/null || echo "?")
  echo "$(_t "将删除规则编号：%s，删除后将变为（剩余 %s 条）：" "L_CLI_AFTER_DEL" "$nums" "$n")"
  echo "$merged" | _fmt_rules
  if [ "$yes" != 1 ]; then echo "$(_t "未加 --yes，仅预览，未执行任何变更。" "L_CLI_DRYRUN")"; exit 0; fi
  local out; out=$(o network security-list update --security-list-id "$SEL_SLID" --ingress-security-rules "$merged" --force 2>&1)
  if [ $? -eq 0 ]; then
    echo "$(_t "已删除。" "L_DELETED")"
    notify "关闭端口成功" "$SEL_NAME" "已删除规则编号：$nums" "状态：已生效，当前入站规则 $(_sl_count "$SEL_SLID") 条"
  else
    echo "$(_t "失败：" "L_FAILED")$(_oci_err "$out")"
    notify "关闭端口失败" "$SEL_NAME" "原因：$(_oci_err "$out")"; exit 1
  fi
}
# CLI：删除全部规则，按给定端口列表重建
cli_replace_all(){
  local inst="" acc="" region="" pw="${OCI_CN_PASS:-}" ports="" yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --instance) inst="$2"; shift 2;; --account) acc="$2"; shift 2;;
      --region) region="$2"; shift 2;; --password) echo "$(_t "警告：--password 会暴露在进程列表，请改用 OCI_CN_PASS 环境变量" "L_PW_WARN")"; pw="$2"; shift 2;;
      --ports) ports="$2"; shift 2;; --replace-all) shift;;
      --yes) yes=1; shift;; -h|--help) cli_usage; exit 0;;
      *) echo "$(_t "未知参数: $1" "L_UNKNOWN_ARG")"; cli_usage; exit 1;;
    esac
  done
  [ -z "$inst" ] && { echo "$(_t "缺少 --instance 参数" "L_MISSING_INST")"; cli_usage; exit 1; }
  [ -z "$ports" ] && { echo "$(_t "--replace-all 需要 --ports，如 \"22/tcp,6700/tcp\"" "L_CLI_PORTS_REQ")"; cli_usage; exit 1; }
  _cli_auth "$pw"
  _cli_locate_instance "$inst" "$acc" "$region" || exit 1
  _cli_first_seclist || exit 1
  local oldifs="$IFS"; IFS=','; local -a entries=($ports); IFS="$oldifs"
  local -a rules=(); local e pp pr rule
  for e in "${entries[@]}"; do
    e="${e// /}"
    [ -z "$e" ] && continue
    if [[ "$e" == */* ]]; then pp="${e%%/*}"; pr="${e##*/}"; else pp="$e"; pr=""; fi
    pr=$(printf '%s' "$pr" | tr 'A-Z' 'a-z')
    if [ -z "$pr" ]; then
      if [ "$pp" = icmp ] || [ "$pp" = all ]; then pr="$pp"; pp=""; else pr="tcp"; fi
    fi
    rule=$(_cli_rule_json "$pr" "$pp") || { echo "$(_t "端口项无效: %s" "L_CLI_INVALID_PORT" "$e")"; exit 1; }
    rules+=("$rule")
  done
  [ "${#rules[@]}" -eq 0 ] && { echo "$(_t "--replace-all 需要 --ports" "L_CLI_PORTS_REQ")"; exit 1; }
  local cur merged n old_n
  cur=$(o network security-list get --security-list-id "$SEL_SLID" --query 'data."ingress-security-rules"' 2>/dev/null)
  old_n=$(echo "$cur" | jq 'length' 2>/dev/null || echo "?")
  merged=$(printf '%s\n' "${rules[@]}" | jq -c -s '.')
  n=$(echo "$merged" | jq 'length' 2>/dev/null || echo "?")
  echo "$(_t "安全列表：%s" "L_CLI_SECLIST" "$SEL_SLNAME")"
  echo "$(_t "当前入站规则（%s 条，将被整体替换）：" "L_CLI_CUR_N" "$old_n")"; echo "$cur" | _fmt_rules
  echo "$(_t "替换后将变为（共 %s 条）：" "L_CLI_AFTER_REPLACE" "$n")"
  echo "$merged" | _fmt_rules
  if [ "$yes" != 1 ]; then echo "$(_t "未加 --yes，仅预览，未执行任何变更。" "L_CLI_DRYRUN")"; exit 0; fi
  local out; out=$(o network security-list update --security-list-id "$SEL_SLID" --ingress-security-rules "$merged" --force 2>&1)
  if [ $? -eq 0 ]; then
    echo "$(_t "已替换全部规则。" "L_CLI_REPLACE_DONE")"
    notify "替换全部规则成功" "$SEL_NAME" "原 $old_n 条 → 现 $n 条" "状态：已生效，当前入站规则 $(_sl_count "$SEL_SLID") 条"
  else
    echo "$(_t "失败：" "L_FAILED")$(_oci_err "$out")"
    notify "替换全部规则失败" "$SEL_NAME" "原因：$(_oci_err "$out")"; exit 1
  fi
}
cli_list_rules(){
  local inst="" acc="" region="" pw="${OCI_CN_PASS:-}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --instance) inst="$2"; shift 2;;
      --account) acc="$2"; shift 2;;
      --region) region="$2"; shift 2;;
      --password) pw="$2"; shift 2;;
      -h|--help) cli_usage; exit 0;;
      *) echo "$(_t "未知参数: $1" "L_UNKNOWN_ARG")"; cli_usage; exit 1;;
    esac
  done
  [ -z "$inst" ] && { echo "$(_t "缺少 --instance 参数" "L_MISSING_INST")"; cli_usage; exit 1; }
  _cli_auth "$pw"
  _cli_locate_instance "$inst" "$acc" "$region" || exit 1
  _show_effective
}

uninstall_self(){
  local self selfdir c delcfg delcli _uh
  self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
  selfdir="$(dirname "$self")"
  echo
  echo " $(_t "── 卸载 oci-cn ──" "L_UNINSTALL_TITLE")"
  echo " $(_t "将删除主程序和语言包：" "L_UNINSTALL_FILES")$self"
  [ -w "$self" ] || { echo " $(_t "主程序不可写，请用 sudo 运行后再卸载" "L_UNINSTALL_NEEDROOT")"; pause; return; }
  _ask -rp " $(_t "同时删除配置目录（含账号与加密密钥，不可恢复）？[y/N]: " "L_UNINSTALL_ASK_CFG")" delcfg
  _ask -rp " $(_t "同时卸载 oci-cli？[y/N]: " "L_UNINSTALL_ASK_CLI")" delcli
  _ask -rp " $(_t "确认卸载？输 yes 继续: " "L_UNINSTALL_CONFIRM")" c
  [ "$c" = "yes" ] || { echo " $(_t "已取消" "L_CANCELLED")"; return; }
  rm -f "$self" || { echo " $(_t "删除主程序失败" "L_UNINSTALL_FAIL")"; pause; return; }
  rm -rf "$selfdir/lang"
  case "$delcfg" in y|Y) rm -rf "$HOME_DIR";; esac
  case "$delcli" in y|Y)
    rm -f "$HOME/bin/oci" /usr/local/bin/oci 2>/dev/null
    rm -rf "$HOME/lib/oracle-cli" "$HOME/.oci" 2>/dev/null
    [ -n "$SUDO_USER" ] && { _uh="$(eval echo "~$SUDO_USER")"; rm -f "$_uh/bin/oci" 2>/dev/null; rm -rf "$_uh/lib/oracle-cli" "$_uh/.oci" 2>/dev/null; }
    ;; esac
  echo " $(_t "卸载完成。再见。" "L_UNINSTALL_DONE")"
  exit 0
}

main(){
  unlock; prepare_runtime
  while true; do
    echo; line; printf "  $(_t "oci-cn v%s  —  甲骨文云中文管理" "L_MAIN_TITLE" "$VERSION")\n" "$VERSION"; line
    echo " $(_t "1 配置列表（进入账号）" "L_MENU_ACCOUNT")"; echo " $(_t "2 系统配置" "L_MENU_SYSTEM")"; echo " $(_t "3 卸载" "L_MENU_UNINSTALL")"; echo " $(_t "0 退出" "L_MENU_EXIT")"
    _ask -rp "$(_t "选择" "L_CHOOSE"): " m
    case "$m" in
      1) list_accounts || { pause; continue; }; _ask -rp "$(_t "账号编号" "L_CHOOSE"): " idx; row=$(get_account_by_index "$idx"); [ -z "$row" ] && { echo "$(_t "无效" "L_INVALID")"; continue; }; account_page "$row";;
      2) sys_menu;;
