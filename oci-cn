# 批量查询所有租户实例的端口规则（v6.10.0 重写）
# $1 = all|bad_only   all=列出全部实例全部入站规则并推送全部；bad_only=只列全端口开放项
# 修复：旧版用空密码解密密钥 + 硬编码区域 + 误解析 raw-output JSON，导致全部查询静默失败、报告为空却显示“全部合格”
_rules_fmt_py='
import json, sys, os
try:
  rules = json.load(sys.stdin) or []
except Exception:
  rules = None
mode = os.environ.get("MODE","all")
def prange(o):
  d = (o or {}).get("destination-port-range") or {}
  if not d: return "全部"
  a, b = d.get("min"), d.get("max")
  return str(a) if a == b else "%s-%s" % (a, b)
def bad(r):
  if r.get("source") not in ("0.0.0.0/0", "::/0"): return False
  p = r.get("protocol","")
  if p == "all": return True
  if p == "6": return not ((r.get("tcp-options") or {}).get("destination-port-range"))
  if p == "17": return not ((r.get("udp-options") or {}).get("destination-port-range"))
  return False
hdr = "#### %s ｜ %s\n- 实例：%s\n- 安全列表：%s" % (os.environ["T"], os.environ["R"], os.environ["I"], os.environ["S"])
if rules is None:
  if mode == "all": print(hdr + "\n- ❓ 规则读取失败\n")
  sys.exit(0)
is_bad = any(bad(r) for r in rules)
if mode == "bad_only" and not is_bad: sys.exit(0)
names = {"6":"TCP","17":"UDP","1":"ICMP","58":"ICMPv6","all":"ALL"}
out = [hdr]
if not rules: out.append("- （无入站规则）")
for r in rules:
  p = r.get("protocol","")
  pn = names.get(p, "协议"+p)
  if p == "6": port = prange(r.get("tcp-options"))
  elif p == "17": port = prange(r.get("udp-options"))
  elif p in ("1","58"):
    io = r.get("icmp-options") or {}
    port = ("type %s" % io.get("type")) if io else "全部"
  else: port = "全部"
  mark = " ⚠️" if bad(r) else ""
  out.append("- %s %s ← %s%s" % (pn, port, r.get("source",""), mark))
if is_bad: out.append("- **⚠️ 不合格：全端口开放！**")
out.append("")
print("\n".join(out))
'
batch_list_rules(){
  local mode="$1"
  prepare_runtime
  local total; total=$(awk -F'\t' 'NF&&$1!=""' "$ACC_FILE" | wc -l)
  echo "正在查询 $total 个租户的安全列表..."
  local tmpdir; tmpdir=$(mktemp -d /dev/shm/batchsl.XXXXXX)
  local report_file="$tmpdir/report.txt" err_file="$tmpdir/err.txt" cnt_file="$tmpdir/cnt"
  : > "$report_file"; : > "$err_file"; : > "$cnt_file"
  local idx=0 tname tenancy _u _f home _rest
  while IFS=$'\t' read -r tname tenancy _u _f home _rest; do
    [ -z "$tname" ] && continue
    idx=$((idx+1))
    echo "[$idx/$total] 正在查 $tname..."
    if [ ! -s "$RUN_DIR/$tname.pem" ]; then echo "  ✗ 密钥不可用（未解锁或解密失败）"; echo "$tname：密钥不可用" >> "$err_file"; continue; fi
    local regions="" r cfg
    cfg=$(oci_cfg "$tname" "${home:-us-ashburn-1}")
    regions=$(oci --config-file "$cfg" --region "${home:-us-ashburn-1}" iam region-subscription list --tenancy-id "$tenancy" \
      --query 'data[]."region-name"' 2>/dev/null | jq -r '.[]?' 2>/dev/null)
    [ -z "$regions" ] && regions="$home"
    [ -z "$regions" ] && { echo "  ✗ 无法确定区域"; echo "$tname：无法确定区域" >> "$err_file"; continue; }
    for r in $regions; do
      local insts
      if ! insts=$(oci --config-file "$cfg" --region "$r" compute instance list -c "$tenancy" --all \
          --query 'data[?"lifecycle-state"!=`"TERMINATED"`].[id,"display-name"]' 2>/dev/null | jq -r '.[]?|@tsv' 2>/dev/null); then
        echo "  ✗ $r 实例列表读取失败"; echo "$tname/$r：实例列表读取失败" >> "$err_file"; continue
      fi
      local iid iname
      while IFS=$'\t' read -r iid iname; do
        [ -z "$iid" ] && continue
        echo x >> "$cnt_file"
        local subnet
        subnet=$(oci --config-file "$cfg" --region "$r" compute instance list-vnics --instance-id "$iid" \
          --query 'data[?"is-primary"]|[0]."subnet-id"' --raw-output 2>/dev/null)
        if [ -z "$subnet" ] || [ "$subnet" = null ]; then
          [ "$mode" = all ] && printf '#### %s ｜ %s\n- 实例：%s\n- ❓ 无法读取子网\n\n' "$tname" "$r" "$iname" >> "$report_file"
          continue
        fi
        local sjson slids slid
        sjson=$(oci --config-file "$cfg" --region "$r" network subnet get --subnet-id "$subnet" 2>/dev/null)
        slids=$(echo "$sjson" | jq -r '.data."security-list-ids"[]?' 2>/dev/null)
        for slid in $slids; do
          local sl sname
          sl=$(oci --config-file "$cfg" --region "$r" network security-list get --security-list-id "$slid" 2>/dev/null)
          sname=$(echo "$sl" | jq -r '.data."display-name" // "?"' 2>/dev/null)
          echo "$sl" | jq '.data."ingress-security-rules"' 2>/dev/null \
            | MODE="$mode" T="$tname" R="$r" I="$iname" S="$sname" python3 -c "$_rules_fmt_py" >> "$report_file" 2>/dev/null
        done
      done <<< "$insts"
    done
  done < "$ACC_FILE"

  local ninst; ninst=$(wc -l < "$cnt_file")
  local summary="共 $idx 个租户、$ninst 台实例"
  [ -s "$err_file" ] && summary="$summary；$(wc -l < "$err_file") 项查询失败"
  echo; echo "查询完成（$summary）"
  [ -s "$err_file" ] && { echo "查询失败："; sed 's/^/  /' "$err_file"; }
  if [ -s "$report_file" ]; then
    cat "$report_file"
  elif [ "$ninst" -gt 0 ] && [ "$mode" = bad_only ]; then
    echo "✅ 所有实例端口规则均合格，无全端口开放项"
  else
    echo "⚠️ 未查到任何实例规则（请检查密钥/网络）"
  fi

  echo
  _ask -rp "是否推送到钉钉？(y/n): " yn
  if [ "$yn" = "y" ] || [ "$yn" = "Y" ]; then
    local title="OCI端口规则巡检报告"; [ "$mode" = all ] && title="OCI全部端口规则"
    local head="## $title"$'\n\n'"$summary"$'\n\n'
    [ -s "$err_file" ] && head+="查询失败："$'\n'"$(sed 's/^/- /' "$err_file")"$'\n\n'
    if [ ! -s "$report_file" ]; then
      if [ "$ninst" -gt 0 ] && [ "$mode" = bad_only ]; then body="✅ 所有实例端口规则均合格，无全端口开放项"; else body="⚠️ 未查到任何实例规则（请检查密钥/网络）"; fi
      dingtalk_push "$title" "$head$body"$'\n\n'"时间：$(bj_time)" && echo "已推送" || echo "推送失败，请检查钉钉配置"
    else
      # 按实例块切分，每条不超过约 3500 字符
      local parts; parts=$(python3 - "$report_file" "$tmpdir/part" <<'PY'
import sys
blocks=[b for b in open(sys.argv[1],encoding="utf-8").read().split("\n\n") if b.strip()]
parts=[];cur=""
for b in blocks:
  if cur and len(cur)+len(b)>3500: parts.append(cur);cur=""
  cur+=b+"\n\n"
if cur: parts.append(cur)
for i,p in enumerate(parts,1): open("%s.%d"%(sys.argv[2],i),"w",encoding="utf-8").write(p)
print(len(parts))
PY
)
      local i ok=1
      for ((i=1;i<=parts;i++)); do
        local txt; txt=$(cat "$tmpdir/part.$i")
        local h=""; [ "$i" = 1 ] && h="$head"
        dingtalk_push "$title ($i/$parts)" "## $title ($i/$parts)"$'\n\n'"${h#\#\# $title$'\n\n'}$txt"$'\n'"时间：$(bj_time)" || ok=0
        [ "$i" -lt "$parts" ] && sleep 1
      done
      [ "$ok" = 1 ] && echo "已推送（$parts 条）" || echo "部分推送失败，请检查钉钉配置"
    fi
  fi
  rm -rf "$tmpdir"
}
main
