# 扫描一个区域所有盘，输出：类型 TAB id TAB 名称 TAB 大小 TAB VPU TAB 挂载实例名(空=未挂载)
_scan_region_disks(){
  local r="$1" ads ad
  ads=$(_oc "$r" iam availability-domain list --query 'data[].name' 2>/dev/null | jq -r '.[]' 2>/dev/null)
  declare -A ATT INAME
  local id nm
  while IFS=$'\t' read -r id nm; do [ -n "$id" ] && INAME[$id]="$nm"; done < <(_oc "$r" compute instance list -c "$TENANCY" --all 2>/dev/null \
    | jq -r '.data[]|select(."lifecycle-state"!="TERMINATED")|[.id,."display-name"]|@tsv' 2>/dev/null)
  while IFS=$'\t' read -r id nm; do [ -n "$id" ] && ATT[$id]="${INAME[$nm]:-$nm}"; done < <(_oc "$r" compute volume-attachment list -c "$TENANCY" --all 2>/dev/null \
    | jq -r '.data[]|select(."lifecycle-state"=="ATTACHED")|[."volume-id",."instance-id"]|@tsv' 2>/dev/null)
  while read -r ad; do
    [ -z "$ad" ] && continue
    while IFS=$'\t' read -r id nm; do [ -n "$id" ] && ATT[$id]="${INAME[$nm]:-$nm}"; done < <(_oc "$r" compute boot-volume-attachment list -c "$TENANCY" --availability-domain "$ad" --all 2>/dev/null \
      | jq -r '.data[]|select(."lifecycle-state"=="ATTACHED")|[."boot-volume-id",."instance-id"]|@tsv' 2>/dev/null)
    _oc "$r" bv boot-volume list -c "$TENANCY" --availability-domain "$ad" --all 2>/dev/null \
      | jq -r '.data[]|select(."lifecycle-state"=="AVAILABLE")|[.id,."display-name",(."size-in-gbs"|tostring),(."vpus-per-gb"|tostring)]|@tsv' 2>/dev/null \
      | while IFS=$'\t' read -r id nm sz vp; do printf '引导卷\t%s\t%s\t%s\t%s\t%s\n' "$id" "$nm" "$sz" "$vp" "${ATT[$id]}"; done
    _oc "$r" bv volume list -c "$TENANCY" --availability-domain "$ad" --all 2>/dev/null \
      | jq -r '.data[]|select(."lifecycle-state"=="AVAILABLE")|[.id,."display-name",(."size-in-gbs"|tostring),(."vpus-per-gb"|tostring)]|@tsv' 2>/dev/null \
      | while IFS=$'\t' read -r id nm sz vp; do printf '块存储\t%s\t%s\t%s\t%s\t%s\n' "$id" "$nm" "$sz" "$vp" "${ATT[$id]}"; done
  done <<< "$ads"
}
# 全部盘。$1=only_free 时只登记未挂载的盘（供删除用）
disk_scan_all(){
  local hr="${HOME_REGION:-$OCI_REGION}"
  echo "扫描所有已订阅区域的盘（需要一点时间）..."
  local regs; regs=$(_oc "$hr" iam region-subscription list --tenancy-id "$TENANCY" 2>/dev/null | jq -r '.data[]."region-name"' 2>/dev/null)
  DISK_ID=(); DISK_TYPE=(); DISK_REG=(); DISK_NM=(); DISK_SZ=()
  local i=0 hsum=0 osum=0 fsum=0 fcnt=0 r t id nm sz vp att tag st plines=""
  local -a _pline_arr=() _pline_main_block=()
  local _pi=0 _nblock=0
  printf "%-4s %-20s %-6s %-26s %-6s %-4s %s\n" "编号" "区域" "类型" "名称" "大小" "VPU" "挂载到 / 状态"
  while read -r r; do
    [ -z "$r" ] && continue
    [ "$r" = "$hr" ] && tag="主" || tag="副"
    while IFS=$'\t' read -r t id nm sz vp att; do
      [ -z "$id" ] && continue
      st="${att:-⚠️ 未挂载}"; [ "$tag" = 副 ] && [ -n "$att" ] && st="$att（副区域计费）"
      [ "$tag" = 主 ] && hsum=$((hsum+sz)) || osum=$((osum+sz))
      [ -z "$att" ] && { fsum=$((fsum+sz)); fcnt=$((fcnt+1)); }
      if [ "$1" = only_free ] && [ -n "$att" ]; then continue; fi
      i=$((i+1)); DISK_ID[$i]="$id"; DISK_TYPE[$i]="$t"; DISK_REG[$i]="$r"; DISK_NM[$i]="$nm"; DISK_SZ[$i]="$sz"
      printf "%-4s %-20s %-6s %-26s %-6s %-4s %s\n" "$i" "$r($tag)" "$t" "${nm:0:26}" "${sz}G" "$vp" "$st"
      _pline_arr[$_pi]="${r}(${tag}) ${t} ${nm} ${sz}G → ${st}"
      if [ "$tag" = 主 ] && [ "$t" = 块存储 ]; then _pline_main_block[$_pi]=1; _nblock=$((_nblock+1)); else _pline_main_block[$_pi]=0; fi
      _pi=$((_pi+1))
    done < <(_scan_region_disks "$r")
  done <<< "$regs"
  line
  local hflag=""; [ "$hsum" -gt 200 ] && hflag="  ⚠️ 超出 $((hsum-200))G 计费"
  local _exceed=0; [ "$hsum" -gt 200 ] && _exceed=$((hsum-200))
  local _j _mark
  for _j in $(seq 0 $((_pi-1)) 2>/dev/null); do
    _mark=""
    if [ "$_exceed" -gt 0 ] && [ "${_pline_main_block[$_j]}" = 1 ]; then
      if [ "$_nblock" -eq 1 ]; then
        _mark="$(_t "（其中%sG超出免费限额会被计费）" "L_EXCEED_FREE" "$_exceed")"
      else
        _mark="$(_t "（部分超出免费限额会被计费）" "L_EXCEED_PART")"
      fi
    fi
    plines="${plines}${_pline_arr[$_j]}${_mark}  
"
  done
  echo "主区域合计：${hsum}G / 免费 200G${hflag}"
  echo "副区域合计：${osum}G（不在免费额度内）"
  echo "$(_t "未挂载：%s 个，共 %sG" "L_UNATTACHED_SUM" "${fcnt}" "${fsum}")"
  DISK_COUNT=$i
  [ "$1" = only_free ] || _push_acct "💽" "全部盘" "${plines}" "主区域：${hsum}G / 免费200G${hflag}" "副区域：${osum}G（计费）" "未挂载：${fcnt} 个 ${fsum}G"
}
# 新建块存储卷（当前区域，不挂载）
